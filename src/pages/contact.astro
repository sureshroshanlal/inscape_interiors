---
import Layout from "../layouts/Layout.astro";

// Replace with actual Formspree form ID from formspree.io
const FORMSPREE_ID = "YOUR_FORMSPREE_ID";
---

<Layout title="Contact — Inscape Interiors">
  <section class="w-full py-12 md:py-section">
    <div class="flex flex-col md:flex-row gap-16 items-start">
      <!-- Left: Image (Unchanged) -->
      <div class="hidden md:block w-full md:w-[45%] fade-in-element opacity-0">
        <img
          src="/images/interiors-side.jpg"
          alt="Inscape Interiors Studio"
          class="w-full h-auto"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Right: Contact details + Form -->
      <div class="w-full md:w-[55%] flex flex-col justify-start">
        <h1
          class="text-[48px] md:text-[56px] font-bold font-serif text-hyperlink leading-tight mb-10 fade-in-element opacity-0"
        >
          Contact
        </h1>

        <!-- Contact Details (Updated Address) -->
        <div class="space-y-1.5 mb-12 fade-in-element opacity-0 font-bold">
          <p class="text-lg font-bold text-hyperlink">Inscape Interiors</p>
          <p class="text-lg font-bold text-hyperlink">
            Pent House, Plot No. 114, TVS Avenue,
          </p>
          <p class="text-lg font-bold text-hyperlink">
            Prashanthi Hills Colony, Street-3, Raidurgam,
          </p>
          <p class="text-lg font-bold text-hyperlink">
            Hyderabad.
          </p>
          <p class="text-lg font-bold text-hyperlink pt-3">
            <a
              href="mailto:dezinekraft.studio@gmail.com"
              class="hover:opacity-60 transition-opacity duration-300 font-bold"
            >
              dezinekraft.studio@gmail.com
            </a>
          </p>
          <p class="text-lg font-bold text-hyperlink">
            <a
              href="tel:+919705006969"
              class="hover:opacity-60 transition-opacity duration-300 font-bold"
            >
              +91 97050 06969
            </a>
          </p>
        </div>

        <!-- Enquiry Form -->
        <form
          action={`https://formspree.io/f/${FORMSPREE_ID}`}
          method="POST"
          class="space-y-8 fade-in-element opacity-0"
        >
          <!-- Name -->
          <div>
            <label
              for="name"
              class="text-[11px] uppercase tracking-widest text-hyperlink block mb-2 font-medium"
            >
              Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full bg-transparent border-b border-hyperlink/30 pb-2 text-base text-hyperlink focus:outline-none focus:border-hyperlink transition-colors placeholder:text-hyperlink/40"
              placeholder="Your name"
            />
          </div>

          <!-- Email -->
          <div>
            <label
              for="email"
              class="text-[11px] uppercase tracking-widest text-hyperlink block mb-2 font-medium"
            >
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full bg-transparent border-b border-hyperlink/30 pb-2 text-base text-hyperlink focus:outline-none focus:border-hyperlink transition-colors placeholder:text-hyperlink/40"
              placeholder="Your email"
            />
          </div>

          <!-- Phone -->
          <div>
            <label
              for="phone"
              class="text-[11px] uppercase tracking-widest text-hyperlink block mb-2 font-medium"
            >
              Phone
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full bg-transparent border-b border-hyperlink/30 pb-2 text-base text-hyperlink focus:outline-none focus:border-hyperlink transition-colors placeholder:text-hyperlink/40"
              placeholder="Your phone number"
            />
          </div>

          <!-- Enquiry -->
          <div>
            <label
              for="enquiry"
              class="text-[11px] uppercase tracking-widest text-hyperlink block mb-2 font-medium"
            >
              Enquiry
            </label>
            <textarea
              id="enquiry"
              name="enquiry"
              rows="5"
              required
              class="w-full bg-transparent border-b border-hyperlink/30 pb-2 text-base text-hyperlink focus:outline-none focus:border-hyperlink transition-colors resize-none placeholder:text-hyperlink/40"
              placeholder="Tell us about your project..."></textarea>
          </div>

          <!-- Submit -->
          <div class="pt-2">
            <button
              type="submit"
              class="inline-block px-8 py-3 bg-secondary text-primary rounded-full border border-secondary hover:bg-primary hover:text-secondary transition-colors duration-300 text-base font-bold"
            >
              Send Enquiry
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Google Maps Location Section -->
    <div class="mt-16 md:mt-24 pt-10 border-t border-hyperlink/15 fade-in-element opacity-0">
      <div class="mb-6">
        <span class="text-[11px] uppercase tracking-widest text-hyperlink/70 block mb-1 font-serif font-bold">
          Studio Location
        </span>
        <h2 class="text-2xl md:text-3xl font-serif font-bold text-hyperlink">
          Find Us in Raidurgam, Hyderabad
        </h2>
        <p class="text-sm text-hyperlink/70 font-serif mt-1">
          Pent House, Plot No. 114, TVS Avenue, Prashanthi Hills Colony, Street-3, Raidurgam, Hyderabad
        </p>
      </div>

      <!-- Responsive Google Map Container -->
      <div class="w-full overflow-hidden rounded-xl border border-hyperlink/20 shadow-sm min-h-[380px] md:min-h-[450px]">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3806.867240614794!2d78.37793522947311!3d17.41815769036869!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bcb95005337e59d%3A0xeee912db52b9ba63!2sTVS%20AVENUE!5e0!3m2!1sen!2sin!4v1792689985620!5m2!1sen!2sin"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title="Inscape Interiors Studio Location on Google Maps"
          class="w-full h-[380px] md:h-[450px] border-0"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>

<style>
  .fade-in-element {
    transition:
      opacity 1.2s ease-out,
      transform 1.2s ease-out;
    transform: translateY(20px);
  }

  .fade-in-element.visible {
    opacity: 1 !important;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.add("visible");
          }, index * 200);
        }
      });
    },
    { threshold: 0.15 },
  );

  document.querySelectorAll(".fade-in-element").forEach((el) => {
    observer.observe(el);
  });
</script>
