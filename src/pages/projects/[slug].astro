---
import Layout from "../../layouts/Layout.astro";
import { projectsData } from "../../data/projectsData";

export async function getStaticPaths() {
  return projectsData.map((project, index) => {
    const prevProject =
      index > 0 ? projectsData[index - 1] : projectsData[projectsData.length - 1];
    const nextProject =
      index < projectsData.length - 1
        ? projectsData[index + 1]
        : projectsData[0];

    return {
      params: { slug: project.slug },
      props: { project, prevProject, nextProject, projectIndex: index + 1 },
    };
  });
}

const { project, prevProject, nextProject, projectIndex } = Astro.props;
const {
  name,
  category,
  location,
  scope,
  style,
  summary,
  highlights,
  coverImage,
  gallery,
} = project;
---

<Layout
  title={`${name} — Inscape Interiors`}
  description={summary || `Explore ${name} by Inscape Interiors in ${location}.`}
>
  <!-- SUBHEADER / BREADCRUMBS -->
  <nav class="w-full bg-primary/60 border-b border-secondary/10 py-3.5 px-4 sm:px-6 lg:px-8">
    <div class="max-w-[1280px] mx-auto flex items-center justify-between text-xs font-serif">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-hyperlink hover:text-secondary transition-colors font-medium"
      >
        <svg class="w-4 h-4 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Back to Projects</span>
      </a>
      <span class="text-secondary/50 uppercase tracking-widest font-semibold text-[11px]">
        Project {projectIndex.toString().padStart(2, "0")} of 11
      </span>
    </div>
  </nav>

  <!-- HERO COVER IMAGE -->
  <section class="relative w-full h-[65vh] md:h-[80vh] overflow-hidden bg-secondary/10 cursor-zoom-in group" id="hero-cover-trigger" data-hero-src={coverImage}>
    <img
      src={coverImage}
      alt={name}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/20 to-black/30 pointer-events-none"></div>

    <!-- Expand hint badge -->
    <div class="absolute top-6 right-6 z-10 opacity-0 group-hover:opacity-100 transition-opacity bg-black/60 backdrop-blur-md text-white text-xs font-serif px-3 py-1.5 rounded-full flex items-center gap-2 pointer-events-none">
      <svg class="w-3.5 h-3.5 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
      </svg>
      <span>Click to expand</span>
    </div>

    <div class="absolute bottom-8 md:bottom-14 left-0 right-0 max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 text-white pointer-events-none">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-md text-white text-xs uppercase tracking-[0.25em] font-serif font-bold rounded-full mb-3">
          {category || "Residential Interior"}
        </span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold font-serif leading-tight mb-3">
          {name}
        </h1>
        {location && (
          <p class="text-white/80 font-serif text-sm md:text-base flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{location}</span>
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- PROJECT METADATA & SPECS BAR -->
  <section class="w-full border-b border-secondary/15 bg-primary/40 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-[1280px] mx-auto grid grid-cols-2 md:grid-cols-4 gap-6 text-secondary">
      <div>
        <span class="block text-[11px] uppercase tracking-widest font-serif text-secondary/50 font-bold mb-1">
          Location
        </span>
        <p class="text-sm md:text-base font-serif font-bold text-hyperlink leading-snug">
          {location || "Hyderabad, Telangana"}
        </p>
      </div>

      <div>
        <span class="block text-[11px] uppercase tracking-widest font-serif text-secondary/50 font-bold mb-1">
          Project Type
        </span>
        <p class="text-sm md:text-base font-serif font-bold text-hyperlink leading-snug">
          {category || "Bespoke Residence"}
        </p>
      </div>

      <div>
        <span class="block text-[11px] uppercase tracking-widest font-serif text-secondary/50 font-bold mb-1">
          Design Scope
        </span>
        <p class="text-sm md:text-base font-serif font-bold text-hyperlink leading-snug">
          {scope || "Turnkey Interior Architecture"}
        </p>
      </div>

      <div>
        <span class="block text-[11px] uppercase tracking-widest font-serif text-secondary/50 font-bold mb-1">
          Aesthetic Style
        </span>
        <p class="text-sm md:text-base font-serif font-bold text-hyperlink leading-snug">
          {style || "Contemporary Luxury"}
        </p>
      </div>
    </div>
  </section>

  <!-- EDITORIAL OVERVIEW -->
  <section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="grid md:grid-cols-12 gap-10 md:gap-16 items-start">
      <div class="md:col-span-4 fade-section opacity-0">
        <span class="text-xs uppercase tracking-[0.25em] font-serif font-bold text-secondary/60 block mb-2">
          Design Narrative
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-hyperlink leading-tight">
          Thoughtful Spatial Planning & Curated Joinery
        </h2>
      </div>

      <div class="md:col-span-8 space-y-6 fade-section opacity-0">
        <p class="text-base sm:text-lg font-serif text-secondary/85 leading-relaxed">
          {summary}
        </p>

        {highlights && highlights.length > 0 && (
          <div class="pt-4">
            <h3 class="text-xs uppercase tracking-[0.2em] font-serif font-bold text-secondary/70 mb-3">
              Craftsmanship Highlights
            </h3>
            <ul class="grid sm:grid-cols-2 gap-3">
              {highlights.map((item) => (
                <li class="flex items-start gap-2.5 text-xs sm:text-sm font-serif text-secondary/80">
                  <span class="w-1.5 h-1.5 rounded-full bg-secondary shrink-0 mt-1.5"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- PROJECT GALLERY WITH EXPANDABLE LIGHTBOX -->
  <section class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 pb-20 md:pb-28">
    <div class="mb-8 flex items-center justify-between border-b border-secondary/15 pb-4">
      <div>
        <span class="text-xs uppercase tracking-[0.25em] font-serif font-bold text-secondary/60 block">
          Visual Walkthrough
        </span>
        <h2 class="text-2xl font-bold font-serif text-hyperlink">
          Project Gallery ({gallery.length} Images)
        </h2>
      </div>
      <span class="text-xs font-serif text-secondary/60 hidden sm:inline-block">
        Click any photo to expand fullscreen
      </span>
    </div>

    <!-- Responsive Gallery Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="project-gallery-grid">
      {
        gallery.map((imgSrc, imgIdx) => (
          <div
            class="gallery-item-card fade-section opacity-0 group relative aspect-[4/3] rounded-xl overflow-hidden bg-secondary/10 border border-secondary/15 shadow-xs cursor-zoom-in"
            data-index={imgIdx}
            data-src={imgSrc}
            role="button"
            tabindex="0"
            aria-label={`Expand image ${imgIdx + 1} of ${gallery.length}`}
          >
            <img
              src={imgSrc}
              alt={`${name} - Gallery Image ${imgIdx + 1}`}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            
            {/* Elegant Hover Overlay */}
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/35 transition-all duration-300 flex items-center justify-center">
              <div class="w-12 h-12 rounded-full bg-white/90 text-secondary shadow-lg opacity-0 group-hover:opacity-100 transform translate-y-3 group-hover:translate-y-0 transition-all duration-300 flex items-center justify-center">
                <svg class="w-5 h-5 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                </svg>
              </div>
            </div>

            <span class="absolute bottom-2.5 right-2.5 text-[10px] font-serif text-white/90 bg-black/60 backdrop-blur-xs px-2.5 py-1 rounded-md opacity-90 transition-opacity">
              {imgIdx + 1} / {gallery.length}
            </span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- NEXT / PREVIOUS PROJECT NAVIGATION -->
  <section class="border-t border-secondary/15 bg-primary/30 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-[1280px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
      <a
        href={`/projects/${prevProject.slug}`}
        class="group inline-flex items-center gap-3 text-secondary hover:text-hyperlink transition-colors"
      >
        <span class="w-9 h-9 rounded-full bg-secondary text-primary flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
          <svg class="w-4 h-4 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </span>
        <div class="text-left">
          <span class="text-[10px] uppercase tracking-widest font-serif text-secondary/50 block">Previous</span>
          <span class="text-sm font-bold font-serif">{prevProject.name}</span>
        </div>
      </a>

      <a
        href="/projects"
        class="px-5 py-2 rounded-full border border-secondary/20 text-xs uppercase tracking-widest font-serif font-bold text-secondary hover:bg-secondary hover:text-primary transition-all"
      >
        All Projects
      </a>

      <a
        href={`/projects/${nextProject.slug}`}
        class="group inline-flex items-center gap-3 text-secondary hover:text-hyperlink transition-colors text-right"
      >
        <div>
          <span class="text-[10px] uppercase tracking-widest font-serif text-secondary/50 block">Next</span>
          <span class="text-sm font-bold font-serif">{nextProject.name}</span>
        </div>
        <span class="w-9 h-9 rounded-full bg-secondary text-primary flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
          <svg class="w-4 h-4 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </a>
    </div>
  </section>

  <!-- FULL-SCREEN LIGHTBOX MODAL -->
  <div
    id="lightbox-modal"
    class="fixed inset-0 z-[999] hidden items-center justify-center bg-black/95 backdrop-blur-md transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Image lightbox"
  >
    <!-- Close button -->
    <button
      id="lightbox-close"
      class="absolute top-5 right-5 z-20 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center backdrop-blur-xs transition-colors cursor-pointer"
      title="Close (Esc)"
    >
      <svg class="w-6 h-6 stroke-[2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Prev button -->
    <button
      id="lightbox-prev"
      class="absolute left-4 sm:left-6 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center backdrop-blur-xs transition-all hover:scale-110 cursor-pointer"
      title="Previous (Left Arrow)"
    >
      <svg class="w-6 h-6 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <!-- Next button -->
    <button
      id="lightbox-next"
      class="absolute right-4 sm:right-6 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center backdrop-blur-xs transition-all hover:scale-110 cursor-pointer"
      title="Next (Right Arrow)"
    >
      <svg class="w-6 h-6 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Main Active Image -->
    <div class="relative max-w-[92vw] max-h-[88vh] flex items-center justify-center" id="lightbox-content">
      <img
        id="lightbox-img"
        src=""
        alt={name}
        class="max-w-[92vw] max-h-[88vh] object-contain rounded-lg shadow-2xl transition-all duration-200"
      />
    </div>

    <!-- Bottom Caption Bar -->
    <div class="absolute bottom-5 left-0 right-0 flex items-center justify-center gap-4 text-white text-xs font-serif tracking-widest uppercase">
      <span id="lightbox-counter" class="bg-white/10 px-3 py-1 rounded-full backdrop-blur-xs">
        1 / {gallery.length}
      </span>
      <span class="text-white/70 hidden sm:inline-block">
        {name} — Inscape Interiors
      </span>
    </div>
  </div>
</Layout>

<style>
  .fade-section {
    transform: translateY(30px);
    transition:
      opacity 0.8s ease-out,
      transform 0.8s ease-out;
  }
  .fade-section.visible {
    opacity: 1 !important;
    transform: translateY(0);
  }
</style>

<script define:vars={{ gallery, coverImage, projectName: name }}>
  // Lightbox Implementation
  let currentIndex = 0;
  const modal = document.getElementById("lightbox-modal");
  const lightboxImg = document.getElementById("lightbox-img");
  const counter = document.getElementById("lightbox-counter");
  const closeBtn = document.getElementById("lightbox-close");
  const prevBtn = document.getElementById("lightbox-prev");
  const nextBtn = document.getElementById("lightbox-next");

  const imagesList = gallery && gallery.length > 0 ? gallery : [coverImage];

  function openLightbox(index) {
    if (!modal || !lightboxImg) return;
    currentIndex = index;
    if (currentIndex < 0) currentIndex = imagesList.length - 1;
    if (currentIndex >= imagesList.length) currentIndex = 0;

    lightboxImg.src = imagesList[currentIndex];
    lightboxImg.alt = `${projectName} photo ${currentIndex + 1}`;
    if (counter) {
      counter.textContent = `${currentIndex + 1} / ${imagesList.length}`;
    }

    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    if (!modal) return;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

  function showNext() {
    openLightbox(currentIndex + 1);
  }

  function showPrev() {
    openLightbox(currentIndex - 1);
  }

  // Attach click to gallery items
  const galleryItems = document.querySelectorAll(".gallery-item-card");
  galleryItems.forEach((item) => {
    item.addEventListener("click", () => {
      const idx = parseInt(item.getAttribute("data-index") || "0", 10);
      openLightbox(idx);
    });

    item.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        const idx = parseInt(item.getAttribute("data-index") || "0", 10);
        openLightbox(idx);
      }
    });
  });

  // Attach click to hero banner trigger
  const heroTrigger = document.getElementById("hero-cover-trigger");
  if (heroTrigger) {
    heroTrigger.addEventListener("click", () => {
      openLightbox(0);
    });
  }

  // Navigation events
  closeBtn?.addEventListener("click", closeLightbox);
  prevBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    showPrev();
  });
  nextBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    showNext();
  });

  // Click outside image to close
  modal?.addEventListener("click", (e) => {
    if (e.target === modal || e.target.id === "lightbox-content") {
      closeLightbox();
    }
  });

  // Keyboard navigation (Esc, ArrowLeft, ArrowRight)
  window.addEventListener("keydown", (e) => {
    if (!modal || modal.classList.contains("hidden")) return;
    if (e.key === "Escape") {
      closeLightbox();
    } else if (e.key === "ArrowLeft") {
      showPrev();
    } else if (e.key === "ArrowRight") {
      showNext();
    }
  });

  // Entrance scroll fade animation
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add("visible");
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll(".fade-section").forEach((el) => observer.observe(el));
</script>
