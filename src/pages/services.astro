---
import Layout from "../layouts/Layout.astro";

const services = [
  {
    id: "turnkey-projects",
    menuTitle: "Turnkey Projects",
    title: "Turnkey Interior Design Projects",
    category: "End-to-End Design, Civil Execution & White-Glove Handover",
    summary:
      "Seamless single-point accountability from concept planning to final snag-free commissioning, backed by two decades of craftsmanship.",
    description1:
      "Our turnkey interior design practice provides complete peace of mind by uniting spatial architecture, structural engineering, bespoke procurement, and site execution under a single responsible team. We eliminate vendor misalignment, compressed schedules, and budget creep through transparent milestone governance and meticulous site supervision.",
    description2:
      "With daily on-site project management and senior craftsmanship supervisors, we uphold exact millimeter tolerances across MEP installations, imported marble dry-lays, custom architectural joinery, and smart automation commissioning for discerning homeowners and commercial developers.",
    deliverables: [
      "Single-Point Design-Build Accountability & Dedicated Project Director",
      "Comprehensive Milestone Scheduling, Gantt Tracking & Budget Governance",
      "Global Material Procurement, Tier-1 Supply Chains & Vendor Coordination",
      "Rigorous Quality Assurance Benchmarks & Laser Level Tolerance Audits",
      "White-Glove Snag-Free Handover, As-Built Documentation & Warranty Support",
    ],
    metric: "170+ Turnkey Projects Delivered",
    image: "/images/services/turnkey-projects.jpg",
    alt: "Inscape Turnkey Interior Design Projects — Luxury Residential Execution",
  },
  {
    id: "renovation-restoration",
    menuTitle: "Renovation & Restoration",
    title: "Renovation & Heritage Restoration",
    category: "Adaptive Reuse, Structural Revival & Modern Upgrades",
    summary:
      "Breathing renewed life and contemporary luxury into existing residences, heritage properties, and aging architectural volumes.",
    description1:
      "Renovation requires a delicate balance of architectural reverence and modern functionality. We reimagine dated layouts, remove structural redundancies, and upgrade mechanical, electrical, and plumbing infrastructure while celebrating the original character and historic soul of the building.",
    description2:
      "Whether restoring heritage woodwork, hand-carved cornices, and historic plaster details or executing a complete down-to-the-brick modern transformation, we preserve emotional resonance while introducing state-of-the-art comforts, hidden acoustic insulation, and timeless luxury.",
    deliverables: [
      "Structural Feasibility Assessment, Load-Bearing Optimization & Floor-Plate Reconfiguration",
      "Heritage Wood Joinery, Ornamental Plaster Moldings & Stone Masonry Restoration",
      "Complete MEP, Waterproofing, Thermal Insulation & Moisture-Proofing Overhauls",
      "Modern Interior Retrofitting, Concealed Conduits & Smart Infrastructure Integration",
      "Turnkey Renovation Supervision with Zero Disruption to Neighboring Environs",
    ],
    metric: "Expert Heritage & Modern Revival",
    image: "/images/services/renovation-restoration.jpg",
    alt: "Inscape Renovation and Restoration Services — Historic High-Ceiling Salon",
  },
  {
    id: "architectural-design",
    menuTitle: "Architectural Design",
    title: "Architectural Design & Spatial Planning",
    category: "Spatial Architecture, Structural Schematics & Facade Engineering",
    summary:
      "Sculpting distinctive contemporary architectural volumes, private villas, and bespoke residences harmonized with daylight and topography.",
    description1:
      "Exquisite interiors are born from architectural integrity. Our architectural design studio conceives fluid floor layouts, double-height lightwells, and clean-lined facades that harmonize modern luxury with micro-climatic responsiveness, daylight harvesting, and contextual materiality.",
    description2:
      "We orchestrate the entire architectural journey from 3D conceptual massing, passive cooling orientation, and cantilevered engineering to municipal compliance drawings, structural coordination, and seamless exterior-interior continuity.",
    deliverables: [
      "Comprehensive Architectural Floor Plans, Elevations & Spatial Volumes",
      "Climate-Responsive Facade Detailing, High-Performance Glazing & Solar Shading",
      "Structural Engineering Coordination & BIM 3D Spatial Modeling",
      "Indoor-Outdoor Living Schematics & Landscape Integration Volumes",
      "Statutory Regulatory Approvals & Construction-Ready Documentation",
    ],
    metric: "20 Years of Architectural Mastery",
    image: "/images/services/architectural-design.jpg",
    alt: "Inscape Architectural Design — Modern Luxury Villa Architecture",
  },
  {
    id: "painting",
    menuTitle: "Painting & Finishes",
    title: "Artisanal Painting & Surface Finishes",
    category: "Italian Stucco, Micro-Cement Screeds & Artisanal Lime Wash",
    summary:
      "Curating tactile surface finishes, hand-troweled Venetian plasters, and artisanal mineral paints that catch light with evocative grace.",
    description1:
      "Walls should not be passive backdrops; they are the tactile canvas of architectural luxury. Our surface finishing artisans specialize in traditional Italian Marmorino, breathable lime plasters, Roman clay, and velvety matte mineral washes that age with organic nobility.",
    description2:
      "Every surface is prepared through meticulous substrate stabilization and multi-coat hand application. From seamless micro-cement wet walls and seamless floor screeds to metallic leafing and textured glaze treatments, we deliver bespoke wall treatments impervious to moisture and rich in depth.",
    deliverables: [
      "Authentic Italian Venetian Plaster & Hand-Burnished Marmorino",
      "Artisanal Slaked Lime Washes, Roman Clay & Breathable Mineral Paints",
      "Seamless Micro-Cement Flooring & Hydrophobic Bathroom Wall Finishes",
      "Custom Textured Wall Paneling, Patina Glazes & Gold/Brass Leafing",
      "Zero-VOC Eco-Friendly Formulations with Micro-Crack Resistance",
    ],
    metric: "Master Artisan Craftsmen",
    image: "/images/services/painting-finishes.jpg",
    alt: "Inscape Artisanal Painting and Venetian Plaster Surface Finishes",
  },
  {
    id: "lighting",
    menuTitle: "Lighting Design",
    title: "Architectural & Circadian Lighting",
    category: "Illumination Schematics, Cove Lighting & Smart DALI Controls",
    summary:
      "Sculpting spaces with light through multi-tiered architectural illumination, circadian tuning, and sculptural statement chandeliers.",
    description1:
      "Light transforms architectural mass into an evocative sanctuary. We engineer multi-layered lighting schemes balancing ambient illumination, focused task lights, accent focal points, and dramatic wall grazing that accentuate materials and artwork without glare.",
    description2:
      "Our lighting consultants integrate circadian rhythm temperature adjustment, invisible magnetic track systems, recessed plaster-in luminaires, and seamless smart lighting automation (Lutron, KNX, DALI) to create dynamic scenes tailored to every hour of the day.",
    deliverables: [
      "Comprehensive Architectural Lighting Layouts & Luminaire Schedules",
      "Circadian Rhythm Human-Centric Illumination & Tunable White Systems",
      "Recessed Plaster-In Trimless Fixtures & Concealed Cove Lighting Profiles",
      "Custom Sculptural Chandelier Sourcing, Commissioning & Installation",
      "Smart Home Lighting Control Integration (Lutron, DALI, KNX, Control4)",
    ],
    metric: "Engineered Illumination",
    image: "/images/services/lighting.jpg",
    alt: "Inscape Architectural Lighting Design — Layered Warm Cove and Pendant Illumination",
  },
  {
    id: "furniture",
    menuTitle: "Furniture",
    title: "Bespoke Handcrafted Furniture",
    category: "Custom Millwork, Seasoned Hardwoods & Fine European Upholstery",
    summary:
      "Commissioning one-of-a-kind statement furniture, sculpted credenzas, and ergonomic seating tailored exclusively to your residence.",
    description1:
      "Showroom furniture rarely fits the proportions and spirit of custom architectural spaces. Inscape designs and manufactures bespoke furniture commissions crafted from kiln-dried Burma teak, American walnut, rare bookmatched marbles, and hand-cast bronze hardware.",
    description2:
      "Our master woodworkers and master upholsterers execute joinery techniques passed down through generations, combining traditional mortise-and-tenon construction with high-resiliency multi-density foam and hand-selected European leathers and bouclés.",
    deliverables: [
      "Custom Dining Tables, Credenzas, Consoles & Architectural Centerpieces",
      "Bespoke Ergonomic Seating, Sofas, Sectionals & Custom Lounge Chairs",
      "Direct Artisan Woodworking, Metal Casting & Stonemason Commissioning",
      "Rare Fabric Curation, Full-Grain Leather Upholstery & Cushion Engineering",
      "White-Glove In-Home Assembly, Placement & Protection Treatment",
    ],
    metric: "Heirloom Grade Millwork",
    image: "/images/services/furniture.jpg",
    alt: "Inscape Bespoke Handcrafted Furniture Workshop — Sculpted Walnut Credenza",
  },
  {
    id: "office-interiors",
    menuTitle: "Office Interiors",
    title: "Corporate & Executive Office Interiors",
    category: "Workplace Strategy, Acoustic Engineering & Brand Prestige",
    summary:
      "Designing high-impact, brand-aligned commercial environments, executive boardrooms, and collaborative modern headquarters.",
    description1:
      "Modern workplaces must inspire innovation, project corporate prestige, and nurture executive wellness. We engineer workplace environments that harmonize open collaborative zones with acoustically isolated focus pods and state-of-the-art boardrooms.",
    description2:
      "From biophilic living greenery walls and ergonomic sit-stand executive suites to integrated AV conferencing and smart access controls, we deliver commercial interiors that attract top talent and impress global clientele.",
    deliverables: [
      "Executive Suites, Chairman Boardrooms & VIP Client Lounges",
      "Agile Open-Plan Layouts, Acoustic Focus Booths & Huddle Spaces",
      "Acoustic Baffle Engineering, Slatted Timber Panels & Sound Masking",
      "Integrated Conference AV, Smart Cable Concealment & Dynamic Power",
      "LEED & WELL Building Standards Compliance for Workplace Health",
    ],
    metric: "High-Performance Workplaces",
    image: "/images/services/office-interiors.jpg",
    alt: "Inscape Corporate Office Interiors — Executive Boardroom with Slatted Oak Paneling",
  },
  {
    id: "commercial-healthcare",
    menuTitle: "Commercial & Healthcare",
    title: "Commercial & Healthcare Facility Interiors",
    category: "Medical Suites, Wellness Clinics & Premium Commercial Venues",
    summary:
      "Balancing clinical hygiene compliance with calming organic aesthetics, optimized circulation, and sensory serenity for patients and guests.",
    description1:
      "Healthcare and specialized wellness clinics require an exacting synthesis of sterile medical protocols and soothing psychological hospitality. We design state-of-the-art dental studios, wellness clinics, and boutique diagnostic centers that alleviate patient anxiety through biophilic architecture, soft indirect lighting, and acoustic tranquility.",
    description2:
      "We select antimicrobial solid surfaces, hospital-grade seamless vinyl flooring, HEPA filtration-compatible ceiling layouts, and contact-free fixtures that satisfy stringent healthcare regulatory standards without sacrificing luxury elegance.",
    deliverables: [
      "Specialized Medical Clinics, Wellness Spas & Dental Suite Planning",
      "Sterile Zone Flow, Patient Privacy Corridors & Non-Slip Slip-Resistant Screeds",
      "Antimicrobial Solid Surface Countertops (Corian, Neolith, Porcelain)",
      "Acoustic Wall Systems for Absolute Doctor-Patient Confidentiality",
      "Healthcare Building Code, Medical Gas Routing & Fire Safety Compliance",
    ],
    metric: "Clinical Hygiene Meets Luxury",
    image: "/images/services/commercial-healthcare.jpg",
    alt: "Inscape Commercial and Healthcare Interiors — Serene Wellness Clinic Reception",
  },
  {
    id: "hospitality-interiors",
    menuTitle: "Hospitality Interiors",
    title: "Hospitality, Restaurants & Boutique Lounges",
    category: "Experiential Venues, Luxury Dining & Member Clubs",
    summary:
      "Crafting immersive, memorable dining environments, boutique hotel lobbies, and cocktail lounges optimized for guest flow and atmosphere.",
    description1:
      "Hospitality interiors rely on narrative and emotional choreography. We sculpt dining rooms, cocktail bars, and boutique hotel lobbies that immerse guests in sensory luxury, combining dramatic backdrops with intimate conversational seating.",
    description2:
      "Our team engineers commercial kitchen adjacencies, back-of-house service corridors, durable high-traffic finishes, and dynamic day-to-night lighting programming that elevates table turns, beverage sales, and brand prestige.",
    deliverables: [
      "Boutique Hotel Lobbies, Cocktail Bars, Cafes & Fine Dining Restaurants",
      "Front-of-House Choreography, Host Stations & Bar Backlighting Displays",
      "Heavy-Traffic Commercial Durability Testing & Stain-Resistant Fabrics",
      "Acoustic Comfort Engineering to Control Ambient Reverberation",
      "Kitchen Exhaust Coordination, POS Integration & Code Compliance",
    ],
    metric: "Immersive Guest Experiences",
    image: "/images/services/hospitality-interiors.jpg",
    alt: "Inscape Hospitality Interiors — Luxury Hotel Cocktail Lounge with Backlit Onyx Bar",
  },
  {
    id: "farmhouses",
    menuTitle: "Luxury Farmhouses",
    title: "Luxury Farmhouses & Country Estates",
    category: "Country Living, Landscape Architecture & Private Acreage Estates",
    summary:
      "Crafting expansive private retreats and contemporary farmhouse estates deeply integrated into landscapes, courtyards, and scenic horizons.",
    description1:
      "Country estates require an architectural philosophy centered on openness, tranquility, and respect for nature. We design sprawling modern farmhouses featuring natural stone masonry, high timber trusses, wraparound verandas, and expansive courtyards centered around olive trees and water features.",
    description2:
      "Our comprehensive approach integrates master site grading, outdoor pavilion kitchens, equestrian facilities, infinity swimming pools, and sustainable off-grid capabilities such as rainwater harvesting and solar orientation.",
    deliverables: [
      "Farmhouse Estate Master Planning, Topographical Integration & Site Layouts",
      "Indoor-Outdoor Living Pavilions, Courtyards & Alfresco Dining Terraces",
      "Exposed Timber Beams, Natural Cut Stone Masonry & Slate Roofing",
      "Swimming Pool, Sunken Firepit & Landscaped Pergola Architecture",
      "Sustainable Off-Grid Infrastructure, Borewell & Solar Integration",
    ],
    metric: "Unrivaled Estate Architecture",
    image: "/images/services/farmhouses.jpg",
    alt: "Inscape Luxury Farmhouses and Country Estates — Sprawling Modern Stone Estate",
  },
  {
    id: "kitchens-wardrobes",
    menuTitle: "Modular Kitchens",
    title: "High-End Modular Kitchens & Wardrobes",
    category: "Precision Millwork, Bespoke Storage & Culinary Architecture",
    summary:
      "Master-crafted culinary islands, precision German fittings, and tailor-made walk-in wardrobes built for enduring daily luxury.",
    description1:
      "The culinary kitchen and private dressing suite are the pinnacle of daily residential luxury. We engineer bespoke modular kitchens featuring quartz and porcelain waterfall islands, anti-fingerprint lacquers, soft-close German hardware, and seamlessly concealed appliances.",
    description2:
      "Our custom wardrobe systems range from backlit glass-door walk-in dressing rooms to velvet-lined jewelry drawers, customized shoe vitrines, and sensor-activated illumination tailored to your personal collection.",
    deliverables: [
      "Custom Modular Kitchen Schematics & Island Centerpieces",
      "Precision German & Italian Hardware Fittings (Blum, Hettich, Häfele)",
      "Bespoke Walk-In Wardrobes, Dressing Suites & Glass Displays",
      "Concealed Built-In Appliances & Ergonomic Storage Organizers",
      "Anti-Scratch, Anti-Fingerprint & Heat-Resistant Luxury Finishes",
    ],
    metric: "Engineered Precision Joinery",
    image: "/images/services/kitchens-wardrobes.jpg",
    alt: "Inscape High-End Modular Kitchens and Wardrobes — Porcelain Waterfall Island",
  },
];
---

<Layout
  title="Services — Inscape Interiors | Turnkey, Architecture & Luxury Interiors"
  description="Explore Inscape Interiors' comprehensive design-build services: Turnkey Interior Projects, Architectural Design, Farmhouses, Heritage Renovation, Modular Kitchens, Corporate Offices, and Bespoke Finishes."
>
  <!-- HERO INTRO -->
  <section class="w-full py-12 md:py-16 text-center">
    <div class="max-w-[840px] mx-auto px-4">
      <span class="inline-block text-[12px] uppercase tracking-[0.25em] text-[#8C6D37] mb-3 font-serif font-bold">
        Comprehensive Design-Build Practice
      </span>
      <h1 class="text-[44px] md:text-[56px] font-bold font-serif text-[#241812] leading-tight mb-6">
        Our Services
      </h1>
      <p class="text-lg max-w-[700px] mx-auto text-[#241812]/90 font-medium leading-relaxed">
        From turnkey interior execution and architectural planning to modular kitchens, corporate workplaces, and artisanal finishes, we provide an integrated suite of architectural and interior services defined by 20 years of craftsmanship.
      </p>
    </div>
  </section>

  <!-- TOGGLE MENU IMPLEMENTATION (All 11 Services) -->
  <section class="w-full pb-20 md:pb-28 px-4 sm:px-6">
    <div class="max-w-[1180px] mx-auto">
      <!-- Mobile Select Picker -->
      <div class="block md:hidden w-full max-w-sm mx-auto mb-8 px-2">
        <label for="mobile-service-select" class="block text-xs uppercase tracking-[0.2em] font-serif font-bold text-[#241812]/70 mb-2 text-center">
          Select Practice Area
        </label>
        <div class="relative">
          <select
            id="mobile-service-select"
            class="w-full appearance-none bg-[#F5EFE8] border-2 border-[#241812]/20 rounded-full px-5 py-3 text-sm font-serif font-bold text-[#241812] focus:outline-none focus:border-[#241812] shadow-xs pr-10 cursor-pointer"
            aria-label="Select Service"
          >
            {services.map((svc, i) => (
              <option value={i} class="bg-[#FAF7F2] text-[#241812] font-serif font-bold py-2">
                {svc.title}
              </option>
            ))}
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-[#241812]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Desktop Toggle Tabs -->
      <nav class="hidden md:flex flex-wrap items-center justify-center gap-2 lg:gap-2.5 w-full mb-10" aria-label="Services Toggle Menu">
        {services.map((svc, i) => (
          <button
            class="service-toggle-btn flex items-center justify-center text-center px-4 py-2.5 rounded-full border border-[#241812]/25 text-xs lg:text-[13.5px] font-serif font-bold tracking-normal leading-tight transition-all duration-300 cursor-pointer whitespace-nowrap"
            data-service-index={i}
            data-service-id={svc.id}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
          >
            {svc.menuTitle}
          </button>
        ))}
      </nav>

      <!-- Active Service Display Card -->
      <div id="active-service-card" class="bg-[#F5EFE8]/85 border border-[#241812]/15 rounded-2xl p-6 md:p-12 shadow-sm">
        <div id="service-content-wrapper" class="space-y-8 transition-opacity duration-300">
          <!-- Header Row -->
          <div class="flex flex-wrap items-start justify-between gap-4 border-b border-[#241812]/15 pb-6">
            <div>
              <span id="svc-category" class="text-xs uppercase tracking-[0.2em] font-serif font-bold text-[#8C6D37] block mb-2">
                {services[0].category}
              </span>
              <h2 id="svc-title" class="text-[34px] md:text-[44px] font-bold font-serif text-[#241812] leading-tight">
                {services[0].title}
              </h2>
              <p id="svc-subtitle" class="text-base md:text-lg text-[#241812]/80 font-serif italic font-medium mt-2">
                {services[0].summary}
              </p>
            </div>
            <div class="shrink-0">
              <span id="svc-metric" class="inline-block px-4 py-1.5 rounded-full border border-[#241812]/20 bg-[#241812]/5 text-xs font-serif font-bold text-[#241812] tracking-wider uppercase">
                {services[0].metric}
              </span>
            </div>
          </div>

          <!-- Image Showcase -->
          <div class="relative overflow-hidden rounded-xl aspect-[16/9] bg-[#241812]/10 shadow-sm">
            <img
              id="svc-image"
              src={services[0].image}
              alt={services[0].alt}
              width="1920"
              height="1080"
              class="w-full h-full object-cover transition-all duration-700 hover:scale-105 cursor-zoom"
              data-zoom
              loading="eager"
            />
            <div class="absolute bottom-3 right-3 bg-[#FAF7F2]/90 backdrop-blur-sm px-3.5 py-1.5 rounded-full text-[11px] font-serif font-bold text-[#241812] border border-[#241812]/15 shadow-sm">
              Click to Expand Image
            </div>
          </div>

          <!-- Description Paragraphs -->
          <div class="space-y-4 text-[#241812]">
            <p id="svc-desc1" class="text-lg font-bold leading-relaxed font-serif">
              {services[0].description1}
            </p>
            <p id="svc-desc2" class="text-lg font-normal leading-relaxed text-[#241812]/90 font-serif">
              {services[0].description2}
            </p>
          </div>

          <!-- Deliverables Checklist -->
          <div class="pt-2">
            <h3 class="text-xs uppercase tracking-[0.2em] font-serif text-[#8C6D37] mb-4 font-bold">
              Key Scope & Deliverables
            </h3>
            <ul id="svc-deliverables" class="grid grid-cols-1 md:grid-cols-2 gap-3.5 text-base text-[#241812]">
              {services[0].deliverables.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-[#B38E46] mt-0.5 text-xs shrink-0">✦</span>
                  <span class="font-bold">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Bottom Actions -->
          <div class="pt-6 border-t border-[#241812]/15 flex flex-wrap items-center justify-between gap-4">
            <a
              id="svc-cta"
              href="/contact"
              class="inline-block border border-[#241812] bg-[#241812] text-[#FAF7F2] rounded-full hover:bg-[#FAF7F2] hover:text-[#241812] transition-colors duration-300 px-8 py-3 text-base font-serif font-semibold"
            >
              Begin Your Bespoke Journey
            </a>

            <!-- Prev / Next Navigation -->
            <div class="flex items-center gap-3">
              <button
                id="btn-prev-service"
                class="px-5 py-2.5 rounded-full border border-[#241812]/20 text-xs font-serif uppercase tracking-wider text-[#241812] hover:bg-[#241812] hover:text-[#FAF7F2] transition-all duration-300 cursor-pointer"
                aria-label="Previous Service"
              >
                ← Previous
              </button>
              <button
                id="btn-next-service"
                class="px-5 py-2.5 rounded-full border border-[#241812]/20 text-xs font-serif uppercase tracking-wider text-[#241812] hover:bg-[#241812] hover:text-[#FAF7F2] transition-all duration-300 cursor-pointer"
                aria-label="Next Service"
              >
                Next →
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BANNER AT BOTTOM -->
  <section class="w-full py-16 md:py-20 text-center border-t border-[#241812]/15 bg-gradient-to-b from-[#FAF7F2] to-[#F5EFE8]">
    <div class="max-w-[700px] mx-auto space-y-6 px-4">
      <h2 class="text-[36px] md:text-[46px] font-bold font-serif text-[#241812] leading-tight">
        Ready to Transform Your Space?
      </h2>
      <p class="text-lg font-bold text-[#241812]/90 max-w-[520px] mx-auto">
        Speak with our design architects about your upcoming residence, commercial space, or bespoke procurement project.
      </p>
      <div class="pt-2">
        <a
          href="/contact"
          class="inline-block border border-[#241812] bg-[#241812] text-[#FAF7F2] rounded-full hover:bg-[#FAF7F2] hover:text-[#241812] transition-colors duration-300 px-9 py-3 text-base font-serif font-bold"
        >
          Schedule a Consultation
        </a>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ services }}>
  let currentIndex = 0;

  const categoryEl = document.getElementById("svc-category");
  const titleEl = document.getElementById("svc-title");
  const subtitleEl = document.getElementById("svc-subtitle");
  const metricEl = document.getElementById("svc-metric");
  const imageEl = document.getElementById("svc-image");
  const desc1El = document.getElementById("svc-desc1");
  const desc2El = document.getElementById("svc-desc2");
  const deliverablesEl = document.getElementById("svc-deliverables");
  const contentWrapper = document.getElementById("service-content-wrapper");

  const toggleBtns = document.querySelectorAll(".service-toggle-btn");
  const mobileSelectEl = document.getElementById("mobile-service-select");
  const prevBtn = document.getElementById("btn-prev-service");
  const nextBtn = document.getElementById("btn-next-service");

  function renderService(index, animate = true) {
    if (index < 0 || index >= services.length) return;
    currentIndex = index;
    const svc = services[index];

    if (animate && contentWrapper) {
      contentWrapper.style.opacity = "0";
      contentWrapper.style.transform = "translateY(8px)";
    }

    setTimeout(() => {
      if (categoryEl) categoryEl.textContent = svc.category;
      if (titleEl) titleEl.textContent = svc.title;
      if (subtitleEl) subtitleEl.textContent = svc.summary;
      if (metricEl) metricEl.textContent = svc.metric;
      if (imageEl) {
        imageEl.src = svc.image;
        imageEl.alt = svc.alt;
      }
      if (desc1El) desc1El.textContent = svc.description1;
      if (desc2El) desc2El.textContent = svc.description2;

      if (deliverablesEl) {
        deliverablesEl.innerHTML = svc.deliverables
          .map(
            (item) => `
            <li class="flex items-start gap-2.5">
              <span class="text-[#B38E46] mt-0.5 text-xs shrink-0">✦</span>
              <span class="font-bold">${item}</span>
            </li>
          `
          )
          .join("");
      }

      toggleBtns.forEach((btn, i) => {
        if (i === index) {
          btn.classList.add("bg-[#241812]", "text-[#FAF7F2]", "border-[#241812]", "shadow-sm");
          btn.classList.remove("text-[#241812]", "border-[#241812]/25", "bg-[#FAF7F2]");
          btn.setAttribute("aria-selected", "true");
        } else {
          btn.classList.remove("bg-[#241812]", "text-[#FAF7F2]", "border-[#241812]", "shadow-sm");
          btn.classList.add("text-[#241812]", "border-[#241812]/25", "bg-[#FAF7F2]");
          btn.setAttribute("aria-selected", "false");
        }
      });

      if (mobileSelectEl) {
        mobileSelectEl.value = String(index);
      }

      if (animate && contentWrapper) {
        contentWrapper.style.transition = "opacity 0.35s ease, transform 0.35s ease";
        contentWrapper.style.opacity = "1";
        contentWrapper.style.transform = "translateY(0)";
      }
    }, animate ? 140 : 0);
  }

  mobileSelectEl?.addEventListener("change", (e) => {
    const target = e.target;
    if (target) {
      const idx = parseInt(target.value, 10);
      renderService(idx, true);
    }
  });

  toggleBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const idx = parseInt(btn.getAttribute("data-service-index") || "0", 10);
      renderService(idx, true);
    });
  });

  prevBtn?.addEventListener("click", () => {
    const nextIdx = (currentIndex - 1 + services.length) % services.length;
    renderService(nextIdx, true);
  });

  nextBtn?.addEventListener("click", () => {
    const nextIdx = (currentIndex + 1) % services.length;
    renderService(nextIdx, true);
  });

  function checkUrlForService() {
    const hash = window.location.hash.replace("#", "").toLowerCase();
    const urlParams = new URLSearchParams(window.location.search);
    const serviceParam = (urlParams.get("service") || "").toLowerCase();
    const target = hash || serviceParam;

    if (target) {
      const aliases = {
        turnkey: "turnkey-projects",
        renovation: "renovation-restoration",
        restoration: "renovation-restoration",
        architecture: "architectural-design",
        painting: "painting",
        finishes: "painting",
        lighting: "lighting",
        furniture: "furniture",
        office: "office-interiors",
        commercial: "commercial-healthcare",
        healthcare: "commercial-healthcare",
        hospitality: "hospitality-interiors",
        farmhouse: "farmhouses",
        farmhouses: "farmhouses",
        kitchen: "kitchens-wardrobes",
        kitchens: "kitchens-wardrobes",
        wardrobes: "kitchens-wardrobes",
      };
      const resolvedTarget = aliases[target] || target;

      const foundIdx = services.findIndex(
        (s) => s.id.toLowerCase() === resolvedTarget || s.id.toLowerCase() === target
      );
      if (foundIdx !== -1) {
        renderService(foundIdx, false);
        return;
      }
    }
    renderService(0, false);
  }

  checkUrlForService();
  window.addEventListener("hashchange", checkUrlForService);
</script>
