---
import Layout from "../layouts/Layout.astro";

const services = [
  {
    id: "turnkey-projects",
    menuTitle: "Turnkey Projects",
    title: "Turnkey Interior Design Projects",
    category: "End-to-End Design, Build & Site Management",
    summary:
      "Seamless single-point accountability from initial architectural vision to white-glove handover, with stringent construction quality controls.",
    description1:
      "Our turnkey practice delivers complete peace of mind by uniting conceptual design, engineering, procurement, and on-site execution under a single responsible team. We eliminate friction between multiple vendors to ensure your space is delivered on schedule and within budget.",
    description2:
      "With daily on-site project management and senior craftsmanship supervisors, we uphold exact architectural tolerances, transparent milestone tracking, and rigorous quality benchmarks for residential, commercial, and bespoke estates.",
    deliverables: [
      "Single-Point Design-Build Accountability & Site Supervision",
      "Comprehensive Turnkey Project Management & Scheduling",
      "Material Procurement, Vendor Governance & Budget Control",
      "Quality Assurance Benchmarks & Tolerance Inspections",
      "White-Glove Snag-Free Handover & Final Commissioning",
    ],
    metric: "170+ Turnkey Projects Delivered",
    image: "/images/services/turnkey-projects.jpg",
    alt: "Inscape Turnkey Interior Design Projects",
  },
  {
    id: "architecture-farmhouses",
    menuTitle: "Architecture & Farmhouses",
    title: "Architectural Design & Luxury Farmhouses",
    category: "Spatial Architecture, Master Planning & Country Estates",
    summary:
      "Sculpting distinctive architectural environments, private villas, and sprawling farmhouse estates connected to daylight and landscape.",
    description1:
      "Great interiors are inseparable from architectural integrity. Our architectural design studio conceives fluid floor layouts, double-height volumes, and facade treatments that harmonize contemporary luxury with natural surroundings and climatic responsiveness.",
    description2:
      "We specialize in bespoke farmhouses, private country estates, and contemporary villas — integrating indoor-outdoor living, landscaped courtyards, daylight harvesting, and sustainable architectural principles from foundation to finish.",
    deliverables: [
      "Architectural Floor Plans, Elevations & Spatial Schematics",
      "Bespoke Luxury Farmhouse & Private Villa Design",
      "Indoor-Outdoor Living & Landscape-Integrated Volumes",
      "Facade Detailing, Fenestration & Climate-Responsive Geometry",
      "Structural Coordination & Regulatory Plan Documentation",
    ],
    metric: "20 Years of Architectural Mastery",
    image: "/images/services/architecture-farmhouses.jpg",
    alt: "Inscape Architectural Design and Luxury Farmhouses",
  },
  {
    id: "renovation-restoration",
    menuTitle: "Renovation & Restoration",
    title: "Renovation & Heritage Restoration",
    category: "Adaptive Reuse, Structural Revival & Modern Upgrades",
    summary:
      "Breathing renewed life and contemporary luxury into existing residences, heritage properties, and aging architectural volumes.",
    description1:
      "Renovation requires a delicate balance of architectural reverence and modern functionality. We reimagine dated layouts, remove structural redundancies, and upgrade mechanical, electrical, and plumbing infrastructure while celebrating the original character of the building.",
    description2:
      "Whether restoring heritage woodwork and historic plaster details or executing a complete down-to-the-brick modern transformation, we preserve emotional resonance while introducing state-of-the-art comforts and timeless luxury.",
    deliverables: [
      "Structural Assessment, Floor-Plate Reconfiguration & Wall Remodeling",
      "Heritage Joinery, Moldings & Architectural Plaster Restoration",
      "Complete MEP, Waterproofing & Thermal Insulation Overhauls",
      "Modern Interior Retrofitting for Contemporary Living",
      "Turnkey Renovation Supervision with Zero Disruption",
    ],
    metric: "Expert Heritage & Modern Revival",
    image: "/images/services/renovation-restoration.jpg",
    alt: "Inscape Renovation and Restoration Services",
  },
  {
    id: "commercial-hospitality",
    menuTitle: "Commercial & Hospitality",
    title: "Corporate Offices, Hospitality & Healthcare",
    category: "Workplace Strategy, Commercial Spaces & Public Venues",
    summary:
      "Designing high-impact, brand-aligned commercial environments, executive offices, boutique hospitality, and specialized healthcare interiors.",
    description1:
      "Commercial spaces demand a strategic intersection of brand identity, acoustic comfort, operational ergonomics, and spatial impression. We design corporate headquarters, collaborative office spaces, and executive boardrooms that foster innovation and elevate client prestige.",
    description2:
      "Our practice extends to boutique hospitality venues, dining spaces, retail flagships, and healthcare facilities — combining aesthetic warmth with stringent hygiene compliance, durable commercial-grade materials, and optimized circulation flows.",
    deliverables: [
      "Corporate Office Interiors, Executive Suites & Boardrooms",
      "Boutique Hospitality, Restaurants, Cafes & Lounge Environments",
      "Healthcare, Wellness Clinics & Specialized Facility Design",
      "Acoustic Planning, Ergonomic Workstations & Smart Lighting",
      "Commercial Building Code, Fire Safety & Accessibility Compliance",
    ],
    metric: "High-Performance Commercial Spaces",
    image: "/images/services/commercial-hospitality.jpg",
    alt: "Inscape Commercial, Office and Hospitality Interiors",
  },
  {
    id: "kitchens-wardrobes",
    menuTitle: "Kitchens & Wardrobes",
    title: "High-End Modular Kitchens & Wardrobes",
    category: "Precision Millwork, Bespoke Storage & Culinary Architecture",
    summary:
      "Master-crafted culinary islands, precision German/Italian fittings, and tailor-made walk-in wardrobes built for enduring refinement.",
    description1:
      "The kitchen and wardrobe are the heart of daily residential luxury. We engineer bespoke modular kitchens featuring quartz and porcelain waterfall islands, anti-fingerprint lacquers, soft-close German hardware, and seamlessly concealed appliances.",
    description2:
      "Our custom wardrobe systems range from backlit glass-door walk-in dressing rooms to velvet-lined jewelry drawers, customized shoe vitrines, and sensor-activated illumination tailored to your personal collection.",
    deliverables: [
      "Custom Modular Kitchen Schematics & Island Centerpieces",
      "Precision German & Italian Hardware Fittings (Blum, Hettich, Hafele)",
      "Bespoke Walk-In Wardrobes, Dressing Suites & Glass Displays",
      "Concealed Built-In Appliances & Ergonomic Storage Organizers",
      "Anti-Scratch, Anti-Fingerprint & Heat-Resistant Luxury Finishes",
    ],
    metric: "Engineered Precision Joinery",
    image: "/images/services/kitchens-wardrobes.jpg",
    alt: "Inscape High-End Modular Kitchens and Wardrobes",
  },
  {
    id: "furniture-lighting-finishes",
    menuTitle: "Furniture & Lighting",
    title: "Bespoke Furniture, Lighting & Surface Finishes",
    category: "Custom Furnishings, Illumination Schematics & Luxury Painting",
    summary:
      "Curating statement handcrafted furniture, multi-layered architectural lighting, and artisanal lime plasters and luxury painting.",
    description1:
      "Tactility, lighting, and artisanal finishes elevate a structure into an evocative sanctuary. We craft customized furniture commissions using seasoned hardwoods, rare marbles, and fine European fabrics that cannot be found off the showroom floor.",
    description2:
      "We pair custom furnishings with multi-tiered lighting schemes (ambient, accent, task) and luxury wall treatments — including artisanal lime plasters, micro-cement screeds, and specialized textured painting that catch the light with subtle elegance.",
    deliverables: [
      "Custom Bespoke Furniture Design & Artisan Manufacturing",
      "Architectural, Decorative & Circadian Lighting Schematics",
      "Artisanal Painting, Italian Stucco & Textured Lime Plaster Finishes",
      "Rare Fabric Curation, Leather Upholstery & Soft Furnishings",
      "Direct Artisan Procurement & White-Glove Installation",
    ],
    metric: "Artisanal Textures & Illumination",
    image: "/images/services/furniture-lighting.jpg",
    alt: "Inscape Furniture, Lighting, Painting and Surface Finishes",
  },
];
---

<Layout
  title="Services — Inscape Interiors"
  description="Explore Inscape Interiors' comprehensive design-build services: Turnkey Interior Projects, Architectural Design & Farmhouses, Renovation & Restoration, Commercial & Hospitality, Modular Kitchens & Wardrobes, and Bespoke Furniture & Lighting."
>
  <!-- HERO INTRO -->
  <section class="w-full py-12 md:py-16 text-center">
    <div class="max-w-[800px] mx-auto">
      <span
        class="inline-block text-[12px] uppercase tracking-[0.25em] text-hyperlink/70 mb-3 font-serif"
      >
        Comprehensive Design-Build Practice
      </span>
      <h1
        class="text-[44px] md:text-[56px] font-bold font-serif text-hyperlink leading-tight mb-6 fade-in-element opacity-0"
      >
        Our Services
      </h1>
      <p
        class="text-lg max-w-[660px] mx-auto text-hyperlink fade-in-element opacity-0 font-bold"
      >
        From turnkey interior execution and architectural planning to modular kitchens, commercial workplaces, and artisanal finishes, we provide an integrated suite of architectural and interior services defined by 20 years of craftsmanship.
      </p>
    </div>
  </section>

  <!-- TOGGLE MENU IMPLEMENTATION (All on the same screen) -->
  <section class="w-full pb-20 md:pb-28">
    <div class="max-w-[1140px] mx-auto">
      <!-- Mobile Compact Service Dropdown Picker (Visible on Mobile only) -->
      <div class="block md:hidden w-full max-w-sm mx-auto mb-8 px-2">
        <label
          for="mobile-service-select"
          class="block text-xs uppercase tracking-[0.2em] font-serif font-bold text-secondary/70 mb-2 text-center"
        >
          Select Service
        </label>
        <div class="relative">
          <select
            id="mobile-service-select"
            class="w-full appearance-none bg-primary/90 border-2 border-secondary/30 rounded-full px-5 py-3 text-sm font-serif font-bold text-secondary focus:outline-none focus:border-secondary shadow-sm transition-all duration-300 pr-10 cursor-pointer"
            aria-label="Select Service"
          >
            {
              services.map((svc, i) => (
                <option value={i} class="bg-primary text-secondary font-serif font-bold py-2">
                  {svc.title}
                </option>
              ))
            }
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-secondary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Desktop Single Row Toggle Menu (All 6 Services in 1 Row on desktop) -->
      <nav
        class="hidden md:grid grid-cols-6 gap-2 lg:gap-3 w-full mb-10"
        aria-label="Services Toggle Menu"
      >
        {
          services.map((svc, i) => (
            <button
              class="service-toggle-btn flex items-center justify-center text-center px-2 py-3 rounded-full border border-secondary/25 text-xs md:text-[13.5px] lg:text-[14.5px] font-serif font-bold tracking-normal leading-tight transition-all duration-300 cursor-pointer whitespace-nowrap"
              data-service-index={i}
              data-service-id={svc.id}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
            >
              {svc.menuTitle}
            </button>
          ))
        }
      </nav>

      <!-- Active Service Display Card (Updates in place on the same screen) -->
      <div
        id="active-service-card"
        class="bg-primary/40 border border-secondary/15 rounded-2xl p-6 md:p-12 shadow-sm"
      >
        <div
          id="service-content-wrapper"
          class="space-y-8 transition-opacity duration-300"
        >
          <!-- Header Row -->
          <div
            class="flex flex-wrap items-start justify-between gap-4 border-b border-secondary/15 pb-6"
          >
            <div>
              <span
                id="svc-category"
                class="text-xs uppercase tracking-[0.2em] font-serif font-bold text-secondary/70 block mb-2"
              >
                {services[0].category}
              </span>
              <h2
                id="svc-title"
                class="text-[34px] md:text-[44px] font-bold font-serif text-hyperlink leading-tight"
              >
                {services[0].title}
              </h2>
              <p
                id="svc-subtitle"
                class="text-base md:text-lg text-secondary/80 font-serif italic font-bold mt-2"
              >
                {services[0].summary}
              </p>
            </div>
            <div class="shrink-0">
              <span
                id="svc-metric"
                class="inline-block px-4 py-1.5 rounded-full border border-secondary/20 bg-secondary/5 text-xs font-serif font-bold text-secondary tracking-wider uppercase"
              >
                {services[0].metric}
              </span>
            </div>
          </div>

          <!-- Image Showcase -->
          <div
            class="relative overflow-hidden rounded-xl aspect-[16/9] bg-secondary/10 shadow-sm"
          >
            <img
              id="svc-image"
              src={services[0].image}
              alt={services[0].alt}
              width="1920"
              height="1080"
              class="w-full h-full object-cover transition-all duration-700 hover:scale-105 cursor-zoom"
              data-zoom
              loading="eager"
            />
            <div
              class="absolute bottom-3 right-3 bg-primary/85 backdrop-blur-sm px-3 py-1 rounded-md text-[11px] font-serif font-bold text-secondary border border-secondary/15"
            >
              Click to Expand Image
            </div>
          </div>

          <!-- Description Paragraphs (Enlarged by 2 pts across all pages) -->
          <div class="space-y-4 text-hyperlink">
            <p
              id="svc-desc1"
              class="text-lg font-bold leading-relaxed"
            >
              {services[0].description1}
            </p>
            <p
              id="svc-desc2"
              class="text-lg font-bold leading-relaxed"
            >
              {services[0].description2}
            </p>
          </div>

          <!-- Deliverables Checklist -->
          <div class="pt-2">
            <h3
              class="text-xs uppercase tracking-[0.2em] font-serif text-secondary/70 mb-4"
            >
              Key Scope & Deliverables
            </h3>
            <ul
              id="svc-deliverables"
              class="grid grid-cols-1 md:grid-cols-2 gap-3 text-base text-hyperlink/90"
            >
              {
                services[0].deliverables.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-secondary/70 mt-1 text-xs shrink-0">✦</span>
                    <span class="font-bold">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Bottom Actions -->
          <div
            class="pt-6 border-t border-secondary/15 flex flex-wrap items-center justify-between gap-4"
          >
            <a
              id="svc-cta"
              href="/contact"
              class="inline-block border border-secondary bg-secondary text-primary rounded-full hover:bg-primary hover:text-secondary transition-colors duration-300 px-8 py-3 text-base font-serif"
            >
              Begin Your Bespoke Journey
            </a>

            <!-- Prev / Next Navigation -->
            <div class="flex items-center gap-3">
              <button
                id="btn-prev-service"
                class="px-5 py-2.5 rounded-full border border-secondary/20 text-xs font-serif uppercase tracking-wider text-secondary hover:bg-secondary hover:text-primary transition-all duration-300 cursor-pointer"
                aria-label="Previous Service"
              >
                ← Previous
              </button>
              <button
                id="btn-next-service"
                class="px-5 py-2.5 rounded-full border border-secondary/20 text-xs font-serif uppercase tracking-wider text-secondary hover:bg-secondary hover:text-primary transition-all duration-300 cursor-pointer"
                aria-label="Next Service"
              >
                Next →
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BANNER AT BOTTOM -->
  <section class="w-full py-16 md:py-20 text-center border-t border-secondary/15">
    <div class="max-w-[700px] mx-auto space-y-6">
      <h2
        class="text-[36px] md:text-[46px] font-bold font-serif text-hyperlink leading-tight"
      >
        Ready to Transform Your Space?
      </h2>
      <p class="text-lg font-bold text-hyperlink max-w-[520px] mx-auto">
        Speak with our design architects about your upcoming residence, commercial space, or bespoke procurement project.
      </p>
      <div class="pt-2">
        <a
          href="/contact"
          class="inline-block border border-secondary bg-secondary text-primary rounded-full hover:bg-primary hover:text-secondary transition-colors duration-300 px-9 py-3 text-base font-serif font-bold"
        >
          Schedule a Consultation
        </a>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ services }}>
  let currentIndex = 0;

  // DOM Elements
  const categoryEl = document.getElementById("svc-category");
  const titleEl = document.getElementById("svc-title");
  const subtitleEl = document.getElementById("svc-subtitle");
  const metricEl = document.getElementById("svc-metric");
  const imageEl = document.getElementById("svc-image");
  const desc1El = document.getElementById("svc-desc1");
  const desc2El = document.getElementById("svc-desc2");
  const deliverablesEl = document.getElementById("svc-deliverables");
  const contentWrapper = document.getElementById("service-content-wrapper");

  const toggleBtns = document.querySelectorAll(".service-toggle-btn");
  const mobileSelectEl = document.getElementById("mobile-service-select");
  const prevBtn = document.getElementById("btn-prev-service");
  const nextBtn = document.getElementById("btn-next-service");

  function renderService(index, animate = true) {
    if (index < 0 || index >= services.length) return;
    currentIndex = index;
    const svc = services[index];

    if (animate && contentWrapper) {
      contentWrapper.style.opacity = "0";
      contentWrapper.style.transform = "translateY(8px)";
    }

    setTimeout(() => {
      if (categoryEl) categoryEl.textContent = svc.category;
      if (titleEl) titleEl.textContent = svc.title;
      if (subtitleEl) subtitleEl.textContent = svc.summary;
      if (metricEl) metricEl.textContent = svc.metric;
      if (imageEl) {
        imageEl.src = svc.image;
        imageEl.alt = svc.alt;
      }
      if (desc1El) desc1El.textContent = svc.description1;
      if (desc2El) desc2El.textContent = svc.description2;

      if (deliverablesEl) {
        deliverablesEl.innerHTML = svc.deliverables
          .map(
            (item) => `
            <li class="flex items-start gap-2.5">
              <span class="text-secondary/70 mt-1 text-xs shrink-0">✦</span>
              <span class="font-bold">${item}</span>
            </li>
          `,
          )
          .join("");
      }

      // Update Desktop Toggle Buttons Active State
      toggleBtns.forEach((btn, i) => {
        if (i === index) {
          btn.classList.add("bg-secondary", "text-primary", "border-secondary", "shadow-sm");
          btn.classList.remove("text-secondary", "border-secondary/25", "bg-primary/40");
          btn.setAttribute("aria-selected", "true");
        } else {
          btn.classList.remove("bg-secondary", "text-primary", "border-secondary", "shadow-sm");
          btn.classList.add("text-secondary", "border-secondary/25", "bg-primary/40");
          btn.setAttribute("aria-selected", "false");
        }
      });

      // Update Mobile Dropdown Selected Value
      if (mobileSelectEl) {
        mobileSelectEl.value = String(index);
      }

      if (animate && contentWrapper) {
        contentWrapper.style.transition = "opacity 0.35s ease, transform 0.35s ease";
        contentWrapper.style.opacity = "1";
        contentWrapper.style.transform = "translateY(0)";
      }
    }, animate ? 140 : 0);
  }

  // Mobile dropdown select handler
  mobileSelectEl?.addEventListener("change", (e) => {
    const target = e.target;
    if (target) {
      const idx = parseInt(target.value, 10);
      renderService(idx, true);
    }
  });

  // Click handlers for toggle buttons
  toggleBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const idx = parseInt(btn.getAttribute("data-service-index") || "0", 10);
      renderService(idx, true);
    });
  });

  // Prev / Next button handlers
  prevBtn?.addEventListener("click", () => {
    const nextIdx = (currentIndex - 1 + services.length) % services.length;
    renderService(nextIdx, true);
  });

  nextBtn?.addEventListener("click", () => {
    const nextIdx = (currentIndex + 1) % services.length;
    renderService(nextIdx, true);
  });

  // URL Hash or query param pre-selection (supporting all aliases)
  function checkUrlForService() {
    const hash = window.location.hash.replace("#", "").toLowerCase();
    const urlParams = new URLSearchParams(window.location.search);
    const serviceParam = (urlParams.get("service") || "").toLowerCase();
    const target = hash || serviceParam;

    if (target) {
      const aliases = {
        "sourcing": "furniture-lighting-finishes",
        "furniture": "furniture-lighting-finishes",
        "lighting": "furniture-lighting-finishes",
        "painting": "furniture-lighting-finishes",
        "farmhouse": "architecture-farmhouses",
        "farmhouses": "architecture-farmhouses",
        "architecture": "architecture-farmhouses",
        "turnkey": "turnkey-projects",
        "renovation": "renovation-restoration",
        "restoration": "renovation-restoration",
        "commercial": "commercial-hospitality",
        "office": "commercial-hospitality",
        "offices": "commercial-hospitality",
        "hospitality": "commercial-hospitality",
        "healthcare": "commercial-hospitality",
        "kitchen": "kitchens-wardrobes",
        "kitchens": "kitchens-wardrobes",
        "wardrobes": "kitchens-wardrobes",
      };
      const resolvedTarget = aliases[target] || target;

      const foundIdx = services.findIndex(
        (s) => s.id.toLowerCase() === resolvedTarget || s.id.toLowerCase() === target,
      );
      if (foundIdx !== -1) {
        renderService(foundIdx, false);
        return;
      }
    }
    // Default to first service
    renderService(0, false);
  }

  // Initial render
  checkUrlForService();
  window.addEventListener("hashchange", checkUrlForService);
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .fade-in-element {
    transition:
      opacity 1s ease-out,
      transform 1s ease-out;
    transform: translateY(20px);
  }
  .fade-in-element.visible {
    opacity: 1 !important;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => entry.target.classList.add("visible"), index * 120);
        }
      });
    },
    { threshold: 0.1 },
  );
  document.querySelectorAll(".fade-in-element").forEach((el) => observer.observe(el));
</script>
