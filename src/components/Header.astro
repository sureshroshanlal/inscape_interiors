
---
---

<header class="header-hide relative z-50 w-full bg-primary">
  <!-- Desktop Header -->
  <div class="desktop-header hidden md:flex items-center justify-center relative px-5 py-3">

    <!-- Left Navigation -->
    <nav class="desktop-nav absolute left-5 top-1/2 -translate-y-1/2">
      <ul class="flex flex-col gap-1 text-[16px] lg:text-[18px] font-serif font-bold">
        <li><a href="/projects" class="header-link">Projects</a></li>
        <li><a href="/craftsmanship" class="header-link">Craftsmanship</a></li>
        <li><a href="/sourcing" class="header-link">Sourcing</a></li>
        <li><a href="/about" class="header-link">About</a></li>
      </ul>
    </nav>

    <!-- Centered Logo -->
    <a href="/" class="desktop-logo relative inline-block shrink-0" aria-label="Inscape Interiors home">
      <img
        src="/images/inscape_logo.webp"
        alt="Inscape Interiors"
        class="h-32 lg:h-36 w-auto block object-contain"
      />
      <img
        src="/logo-infinity.svg"
        alt=""
        aria-hidden="true"
        class="absolute pointer-events-none w-8"
        style="top: 18px; left: 44px;"
      />
    </a>

    <!-- Premium Gold Statistics Card -->
    <aside class="stats-card hidden xl:flex" aria-label="Company achievements">
      <div class="stats-glint" aria-hidden="true"></div>

      <div class="stats-item">
        <span class="stats-number">20+</span>
        <span class="stats-label">Years of Experience</span>
      </div>

      <div class="stats-divider" aria-hidden="true">
        <span></span>
      </div>

      <div class="stats-item">
        <span class="stats-number">170+</span>
        <span class="stats-label">Projects Delivered</span>
      </div>

      <span class="stats-spark stats-spark-one" aria-hidden="true">✦</span>
      <span class="stats-spark stats-spark-two" aria-hidden="true">✧</span>
    </aside>

  </div>

  <!-- Mobile Header: Burger Left, Logo Center -->
  <div class="relative flex md:hidden items-center justify-between px-5 py-4">

    <!-- Burger Menu -->
    <button
      id="mobile-toggle"
      class="mobile-toggle relative z-10 p-2"
      aria-label="Toggle navigation menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      type="button"
    >
      <span class="burger-lines space-y-1.5 block">
        <span class="block w-6 h-px bg-secondary transition-all duration-300"></span>
        <span class="block w-7 h-px bg-secondary transition-all duration-300"></span>
        <span class="block w-6 h-px bg-secondary transition-all duration-300"></span>
      </span>
    </button>

    <!-- Centered Mobile Logo -->
    <a
      href="/"
      class="absolute left-1/2 -translate-x-1/2"
      aria-label="Inscape Interiors home"
    >
      <img
        src="/images/inscape_logo.webp"
        alt="Inscape Interiors"
        class="h-16 w-auto block object-contain"
      />
      <img
        src="/logo-infinity.svg"
        alt=""
        aria-hidden="true"
        class="absolute pointer-events-none"
        style="width: 0.75rem; top: 7px; left: 18px;"
      />
    </a>

    <!-- Balancing Spacer -->
    <div class="w-10 z-10" aria-hidden="true"></div>
  </div>

  <!-- Mobile Navigation -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-primary border-t border-secondary/10"
  >
    <nav class="px-5 py-8 flex flex-col gap-4" aria-label="Mobile navigation">
      <a href="/projects" class="mobile-nav-link">Projects</a>
      <a href="/craftsmanship" class="mobile-nav-link">Craftsmanship</a>
      <a href="/sourcing" class="mobile-nav-link">Sourcing</a>
      <a href="/about" class="mobile-nav-link">About</a>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById("mobile-toggle");
  const menu = document.getElementById("mobile-menu");

  if (toggle && menu && !toggle.hasAttribute("data-initialized")) {
    toggle.setAttribute("data-initialized", "true");

    toggle.addEventListener("click", () => {
      const isOpening = menu.classList.contains("hidden");

      menu.classList.toggle("hidden", !isOpening);
      toggle.setAttribute("aria-expanded", String(isOpening));
    });

    // Close the menu after selecting a navigation link
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>

<script>
  // Hide header while scrolling down, reveal while scrolling up
  const header = document.querySelector(".header-hide");

  if (header && !header.hasAttribute("data-scroll-initialized")) {
    header.setAttribute("data-scroll-initialized", "true");

    let lastScroll = window.scrollY;
    let ticking = false;

    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;

        ticking = true;

        window.requestAnimationFrame(() => {
          const currentScroll = window.scrollY;
          const mobileMenu = document.getElementById("mobile-menu");

          if (currentScroll <= 80) {
            header.style.transform = "translateY(0)";
          } else if (currentScroll > lastScroll) {
            // Keep the header visible while the mobile menu is open
            if (!mobileMenu || mobileMenu.classList.contains("hidden")) {
              header.style.transform = "translateY(-100%)";
            }
          } else {
            header.style.transform = "translateY(0)";
          }

          lastScroll = currentScroll;
          ticking = false;
        });
      },
      { passive: true },
    );
  }
</script>

<style>
  /* Header behavior */
  .header-hide {
    position: sticky;
    top: 0;
    transition: transform 0.3s ease;
    will-change: transform;
  }

  /* Navigation links */
  .header-link,
  .mobile-nav-link {
    display: inline-block;
    color: inherit;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .header-link:hover,
  .mobile-nav-link:hover {
    color: #b58a25;
  }

  .mobile-nav-link {
    font-family: serif;
    font-size: 16px;
    font-weight: 700;
  }

  /* Gold statistics card */
  .stats-card {
    position: absolute;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    isolation: isolate;
    overflow: hidden;

    align-items: center;
    justify-content: space-evenly;
    gap: 10px;

    width: clamp(310px, 29vw, 390px);
    min-height: 76px;
    padding: 12px 15px;

    border: 1px solid rgba(190, 148, 43, 0.9);
    border-radius: 13px;

    background:
      radial-gradient(
        ellipse at 50% 0%,
        rgba(255, 255, 255, 0.98) 0%,
        transparent 70%
      ),
      linear-gradient(
        120deg,
        #fff9e7 0%,
        #f5e7b8 24%,
        #fffdf4 49%,
        #f2e1a5 76%,
        #fff9e8 100%
      );

    box-shadow:
      0 5px 16px rgba(112, 80, 15, 0.14),
      0 0 0 1px rgba(221, 185, 83, 0.2),
      inset 0 1px 2px rgba(255, 255, 255, 0.95);

    color: #79520b;
  }

  .stats-item {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-align: center;
  }

  .stats-number {
    display: block;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(23px, 2vw, 30px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.5px;

    background: linear-gradient(
      115deg,
      #8d6413 0%,
      #e3bf50 28%,
      #a47716 55%,
      #f2d77b 76%,
      #8b6313 100%
    );
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;

    filter: drop-shadow(0 1px 0 rgba(255, 255, 255, 0.7));
  }

  .stats-label {
    display: block;
    white-space: nowrap;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 8px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 1.25px;
    text-transform: uppercase;
    color: #765315;
  }

  /* Central gold divider and diamond */
  .stats-divider {
    position: relative;
    z-index: 2;
    align-self: stretch;
    width: 1px;
    margin: 4px 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      #d6ad43 20%,
      #a77917 50%,
      #e8ca70 80%,
      transparent
    );
  }

  .stats-divider span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 7px;
    height: 7px;
    border: 1px solid #d2a632;
    background: #fff7d8;
    transform: translate(-50%, -50%) rotate(45deg);
    box-shadow: 0 0 8px rgba(219, 176, 53, 0.65);
  }

  /* Subtle shimmer passing over the card */
  .stats-glint {
    position: absolute;
    z-index: 1;
    top: -50%;
    left: -55%;
    width: 35%;
    height: 200%;
    pointer-events: none;

    background: linear-gradient(
      105deg,
      transparent 0%,
      rgba(255, 255, 255, 0.04) 25%,
      rgba(255, 255, 255, 0.75) 48%,
      rgba(255, 244, 196, 0.35) 55%,
      transparent 100%
    );

    transform: skewX(-22deg);
    animation: gold-shimmer 7s ease-in-out 2s infinite;
  }

  /* Small decorative twinkles */
  .stats-spark {
    position: absolute;
    z-index: 2;
    color: #d8ad39;
    pointer-events: none;
    animation: gold-twinkle 3.5s ease-in-out infinite;
  }

  .stats-spark-one {
    left: 8%;
    top: 18%;
    font-size: 9px;
  }

  .stats-spark-two {
    right: 7%;
    bottom: 15%;
    font-size: 12px;
    animation-delay: 1.7s;
  }

  @keyframes gold-shimmer {
    0%, 12% {
      left: -55%;
      opacity: 0;
    }

    20% {
      opacity: 0.85;
    }

    45% {
      left: 125%;
      opacity: 0;
    }

    100% {
      left: 125%;
      opacity: 0;
    }
  }

  @keyframes gold-twinkle {
    0%, 100% {
      opacity: 0.35;
      transform: scale(0.8) rotate(0deg);
    }

    50% {
      opacity: 1;
      transform: scale(1.2) rotate(45deg);
    }
  }

  /* Respect accessibility preferences */
  @media (prefers-reduced-motion: reduce) {
    .stats-glint,
    .stats-spark {
      animation: none;
    }

    .header-hide,
    .header-link,
    .mobile-nav-link {
      transition: none;
    }
  }

  /* Smaller desktop screens: retain the original centered logo layout */
  @media (min-width: 768px) and (max-width: 1279px) {
    .desktop-header {
      min-height: 120px;
    }

    .desktop-nav {
      left: 20px;
    }

    .desktop-logo img:first-child {
      max-height: 110px;
    }
  }

  /* Mobile adjustments */
  @media (max-width: 767px) {
    .header-hide {
      width: 100%;
    }
  }
</style>
