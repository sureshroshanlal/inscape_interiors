---
---

<header class="header-hide w-full bg-primary z-50">
  <!-- Desktop Header -->
  <div class="hidden md:flex items-center justify-center relative px-5 py-3">
    <nav class="absolute left-5 top-1/2 -translate-y-1/2">
      <ul class="flex flex-col gap-1 text-[18px] font-serif font-bold">
        <li><a href="/projects" class="hover:opacity-70 transition-opacity">Projects</a></li>
        <li><a href="/craftsmanship" class="hover:opacity-70 transition-opacity">Craftsmanship</a></li>
        <li><a href="/services" class="hover:opacity-70 transition-opacity">Services</a></li>
        <li><a href="/about" class="hover:opacity-70 transition-opacity">About</a></li>
      </ul>
    </nav>

    <!-- Center Logo -->
    <a href="/" class="relative inline-block" aria-label="Inscape Interiors home">
      <img
        src="/images/inscape_logo.png"
        alt="Inscape Interiors"
        class="h-40 w-auto block"
      />
    </a>

    <!-- Desktop Header Ticker (Right Side) -->
    <div class="absolute right-5 top-1/2 -translate-y-1/2 flex items-center">
      <div
        class="header-ticker-box w-[250px] lg:w-[280px] overflow-hidden rounded-full border border-secondary/25 bg-primary/70 py-1.5 px-3 select-none"
        title="20 Years Of Experience, 170+ Projects Delivered"
      >
        <div class="header-ticker-track flex">
          <div class="header-ticker-item flex items-center shrink-0">
            <span class="font-serif text-[13.5px] lg:text-[14.5px] tracking-widest uppercase font-bold text-secondary whitespace-nowrap">
              20 Years Of Experience &nbsp;✦&nbsp; 170+ Projects Delivered &nbsp;✦&nbsp;&nbsp;
            </span>
          </div>
          <div class="header-ticker-item flex items-center shrink-0" aria-hidden="true">
            <span class="font-serif text-[13.5px] lg:text-[14.5px] tracking-widest uppercase font-bold text-secondary whitespace-nowrap">
              20 Years Of Experience &nbsp;✦&nbsp; 170+ Projects Delivered &nbsp;✦&nbsp;&nbsp;
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Header — burger left, logo centered -->
  <div class="relative flex md:hidden items-center justify-between px-5 py-4">
    <!-- Burger left -->
    <button id="mobile-toggle" class="p-2 z-10" aria-label="Toggle menu">
      <div class="space-y-1.5">
        <span class="block w-6 h-px bg-secondary transition-all duration-300"></span>
        <span class="block w-7 h-px bg-secondary transition-all duration-300"></span>
        <span class="block w-6 h-px bg-secondary transition-all duration-300"></span>
      </div>
    </button>

    <!-- Logo centered -->
    <a href="/" class="absolute left-1/2 -translate-x-1/2" aria-label="Inscape Interiors home">
      <img
        src="/images/inscape_logo.png"
        alt="Inscape Interiors"
        class="h-16 w-auto block"
      />
    </a>

    <!-- Spacer to balance burger -->
    <div class="w-10 z-10"></div>
  </div>

  <!-- Mobile Ticker Bar -->
  <div class="md:hidden w-full border-t border-b border-secondary/15 py-1.5 px-2 bg-primary/95 overflow-hidden">
    <div class="header-ticker-box w-full max-w-[340px] mx-auto overflow-hidden">
      <div class="header-ticker-track flex">
        <div class="header-ticker-item flex items-center shrink-0">
          <span class="font-serif text-[13px] tracking-wider uppercase font-bold text-secondary whitespace-nowrap">
            20 Years Of Experience &nbsp;✦&nbsp; 170+ Projects Delivered &nbsp;✦&nbsp;&nbsp;
          </span>
        </div>
        <div class="header-ticker-item flex items-center shrink-0" aria-hidden="true">
          <span class="font-serif text-[13px] tracking-wider uppercase font-bold text-secondary whitespace-nowrap">
            20 Years Of Experience &nbsp;✦&nbsp; 170+ Projects Delivered &nbsp;✦&nbsp;&nbsp;
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-primary border-t border-secondary/10"
  >
    <nav class="px-5 py-8 flex flex-col gap-4">
      <a href="/projects" class="text-[16px] font-serif font-bold">Projects</a>
      <a href="/craftsmanship" class="text-[16px] font-serif font-bold">Craftsmanship</a>
      <a href="/services" class="text-[16px] font-serif font-bold">Services</a>
      <a href="/about" class="text-[16px] font-serif font-bold">About</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>

<script>
  const header = document.querySelector<HTMLElement>(".header-hide");
  let lastScroll = 0;
  if (header) {
    window.addEventListener(
      "scroll",
      () => {
        const currentScroll = window.scrollY;
        if (currentScroll > lastScroll && currentScroll > 80) {
          header.style.transform = "translateY(-100%)";
        } else {
          header.style.transform = "translateY(0)";
        }
        lastScroll = currentScroll;
      },
      { passive: true },
    );
  }
</script>

<style>
  .header-hide {
    position: sticky;
    top: 0;
    transition: transform 0.3s ease;
  }

  /* Header Ticker Styles */
  .header-ticker-box {
    position: relative;
    mask-image: linear-gradient(90deg, transparent 0%, black 12%, black 88%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 12%, black 88%, transparent 100%);
  }

  .header-ticker-track {
    width: max-content;
    animation: header-ticker-slide 14s linear infinite;
    will-change: transform;
  }

  .header-ticker-box:hover .header-ticker-track {
    animation-play-state: paused;
  }

  @keyframes header-ticker-slide {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-ticker-track {
      animation: none;
    }
  }
</style>
