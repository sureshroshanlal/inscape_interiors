---
---

<header class="header-hide w-full bg-primary z-50">
  <!-- Desktop Header -->
  <div class="hidden md:flex items-center justify-center relative px-5 py-3">
    <nav class="absolute left-5 top-1/2 -translate-y-1/2">
      <ul class="flex flex-col gap-1 text-[18px] font-serif font-bold">
        <li><a href="/projects">Projects</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/craftsmanship">Craftsmanship</a></li>
        <li><a href="/sourcing">Sourcing</a></li>
        <li><a href="/about">About</a></li>
      </ul>
    </nav>

    <!-- Center Logo (unchanged) -->
    <a href="/" class="relative inline-block">
      <img
        src="/images/inscape_logo.webp"
        alt="Inscape Interiors"
        class="h-40 w-auto block"
      />
      <img
        src="/logo-infinity.svg"
        alt=""
        class="absolute pointer-events-none w-8"
        style="top: 18px; left: 44px;"
      />
    </a>

    <!-- RIGHT SIDE: Experience Badge (only addition) -->
    <div
      class="gold-badge absolute right-5 top-1/2 -translate-y-1/2"
      role="note"
      aria-label="20 plus years of experience with 170 plus projects delivered"
    >
      <span class="spark spark-1" aria-hidden="true"></span>
      <span class="spark spark-2" aria-hidden="true"></span>
      <span class="spark spark-3" aria-hidden="true"></span>
      <span class="spark spark-4" aria-hidden="true"></span>
      <div class="gold-badge-inner">
        <div class="stat">
          <span class="num">20+</span>
          <span class="lbl">Years of Experience</span>
        </div>
        <span class="divider" aria-hidden="true"></span>
        <div class="stat">
          <span class="num">170+</span>
          <span class="lbl">Projects Delivered</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Header — burger left, logo centered -->
  <div class="relative flex md:hidden items-center justify-between px-5 py-4">
    <button id="mobile-toggle" class="p-2 z-10" aria-label="Toggle menu">
      <div class="space-y-1.5">
        <span class="block w-6 h-px bg-secondary transition-all duration-300"></span>
        <span class="block w-7 h-px bg-secondary transition-all duration-300"></span>
        <span class="block w-6 h-px bg-secondary transition-all duration-300"></span>
      </div>
    </button>

    <a href="/" class="absolute left-1/2 -translate-x-1/2">
      <img
        src="/images/inscape_logo.webp"
        alt="Inscape Interiors"
        class="h-16 w-auto block"
      />
      <img
        src="/logo-infinity.svg"
        alt=""
        class="absolute pointer-events-none"
        style="width: 0.75rem; top: 7px; left: 18px;"
      />
    </a>

    <div class="w-10 z-10"></div>
  </div>

  <!-- Mobile experience strip -->
  <div class="md:hidden flex justify-center px-5 pb-3">
    <div class="gold-badge gold-badge-mobile" role="note">
      <span class="spark spark-1" aria-hidden="true"></span>
      <span class="spark spark-3" aria-hidden="true"></span>
      <div class="gold-badge-inner">
        <span class="num">20+</span><span class="lbl">Yrs Experience</span>
        <span class="divider" aria-hidden="true"></span>
        <span class="num">170+</span><span class="lbl">Projects Delivered</span>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-primary border-t border-secondary/10"
  >
    <nav class="px-5 py-8 flex flex-col gap-4">
      <a href="/projects" class="text-[16px] font-serif font-bold">Projects</a>
      <a href="/services" class="text-[16px] font-serif font-bold">Services</a>
      <a href="/craftsmanship" class="text-[16px] font-serif font-bold">Craftsmanship</a>
      <a href="/sourcing" class="text-[16px] font-serif font-bold">Sourcing</a>
      <a href="/about" class="text-[16px] font-serif font-bold">About</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>

<script>
  const header = document.querySelector<HTMLElement>(".header-hide");
  let lastScroll = 0;
  if (header) {
    window.addEventListener(
      "scroll",
      () => {
        const currentScroll = window.scrollY;
        if (currentScroll > lastScroll && currentScroll > 80) {
          header.style.transform = "translateY(-100%)";
        } else {
          header.style.transform = "translateY(0)";
        }
        lastScroll = currentScroll;
      },
      { passive: true },
    );
  }
</script>

<style>
  .header-hide {
    position: sticky;
    top: 0;
    transition: transform 0.3s ease;
  }

  /* ---------- Gold experience badge ---------- */
  .gold-badge {
    padding: 2px;
    border-radius: 4px;
    background: linear-gradient(
      110deg,
      #a67c1a 0%,
      #e8c766 25%,
      #a67c1a 50%,
      #e8c766 75%,
      #a67c1a 100%
    );
    background-size: 250% 100%;
    animation:
      gold-flow 5s linear infinite,
      gold-glow 2.8s ease-in-out infinite;
  }
  .gold-badge-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 18px;
    border-radius: 2px;
    background: #faf8f2;
    overflow: hidden;
  }
  .gold-badge-inner::after {
    content: "";
    position: absolute;
    top: 0;
    left: -60%;
    width: 40%;
    height: 100%;
    background: linear-gradient(
      100deg,
      transparent,
      rgba(232, 199, 102, 0.4),
      transparent
    );
    transform: skewX(-20deg);
    animation: gold-sweep 4.5s ease-in-out infinite;
  }
  .gold-badge .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.05;
  }
  .gold-badge .num {
    font-weight: 700;
    font-size: 26px;
    color: #7a5a0e;
    letter-spacing: 0.01em;
  }
  .gold-badge .lbl {
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #301804;
    margin-top: 2px;
    text-align: center;
  }
  .gold-badge .divider {
    width: 1px;
    align-self: stretch;
    background: #b8923a;
    opacity: 0.7;
  }

  .gold-badge .spark {
    position: absolute;
    width: 12px;
    height: 12px;
    background: #f1d27a;
    clip-path: polygon(
      50% 0%, 60% 40%, 100% 50%, 60% 60%,
      50% 100%, 40% 60%, 0% 50%, 40% 40%
    );
    opacity: 0;
    z-index: 2;
    animation: twinkle 3s ease-in-out infinite;
  }
  .spark-1 { top: -7px;  left: 10%;  animation-delay: 0s; }
  .spark-2 { top: -5px;  right: 8%;  animation-delay: 0.9s; width: 10px; height: 10px; }
  .spark-3 { bottom: -7px; right: 20%; animation-delay: 1.7s; }
  .spark-4 { bottom: -5px; left: 6%;  animation-delay: 2.3s; width: 10px; height: 10px; }

  /* Mobile compact version */
  .gold-badge-mobile .gold-badge-inner {
    gap: 6px;
    padding: 6px 12px;
  }
  .gold-badge-mobile .num { font-size: 16px; }
  .gold-badge-mobile .lbl {
    font-size: 9px;
    margin-top: 0;
    letter-spacing: 0.08em;
  }
  .gold-badge-mobile .divider { margin: 0 3px; }

  @keyframes gold-flow {
    to { background-position: -250% 0; }
  }
  @keyframes gold-glow {
    0%, 100% { box-shadow: 0 0 4px rgba(200, 160, 50, 0.3); }
    50%      { box-shadow: 0 0 14px rgba(220, 180, 70, 0.7); }
  }
  @keyframes gold-sweep {
    0%, 55% { left: -60%; }
    100%    { left: 130%; }
  }
  @keyframes twinkle {
    0%, 100% { opacity: 0; transform: scale(0.3) rotate(0deg); }
    50%      { opacity: 1; transform: scale(1) rotate(45deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gold-badge,
    .gold-badge-inner::after,
    .gold-badge .spark {
      animation: none;
    }
    .gold-badge .spark { opacity: 0.8; }
  }
</style>
