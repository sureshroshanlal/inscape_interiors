---
---

<header class="header-hide w-full bg-primary z-50">
  <!-- Desktop Header -->
  <div class="hidden md:flex items-center justify-center relative px-5 py-3">
    <nav class="absolute left-5 top-1/2 -translate-y-1/2">
      <ul class="flex flex-col gap-1 text-[18px] font-serif font-bold">
        <li><a href="/projects" class="hover:opacity-70 transition-opacity">Projects</a></li>
        <li><a href="/craftsmanship" class="hover:opacity-70 transition-opacity">Craftsmanship</a></li>
        <li><a href="/services" class="hover:opacity-70 transition-opacity">Services</a></li>
        <li><a href="/about" class="hover:opacity-70 transition-opacity">About</a></li>
      </ul>
    </nav>

    <!-- Center Logo -->
    <a href="/" class="relative inline-block" aria-label="Inscape Interiors home">
      <img
        src="/images/inscape_logo.png"
        alt="Inscape Interiors"
        class="h-40 w-auto block"
      />
    </a>

    <!-- Desktop Header Ticker (Right Side with Golden Ambient Glow) -->
    <div class="absolute right-5 top-1/2 -translate-y-1/2 flex items-center">
      <div
        class="header-ticker-box header-ticker-glow w-[255px] lg:w-[290px] overflow-hidden rounded-full py-1.5 px-3.5 select-none transition-all duration-300"
        title="20 Years Of Experience, 170+ Projects Delivered"
      >
        <div class="header-ticker-track flex">
          <div class="header-ticker-item flex items-center shrink-0">
            <span class="font-serif text-[13.5px] lg:text-[14.5px] tracking-widest uppercase font-bold text-secondary whitespace-nowrap">
              <span class="ticker-num">20</span> Years Of Experience &nbsp;<span class="ticker-spark">✦</span>&nbsp; <span class="ticker-num">170+</span> Projects Delivered &nbsp;<span class="ticker-spark">✦</span>&nbsp;&nbsp;
            </span>
          </div>
          <div class="header-ticker-item flex items-center shrink-0" aria-hidden="true">
            <span class="font-serif text-[13.5px] lg:text-[14.5px] tracking-widest uppercase font-bold text-secondary whitespace-nowrap">
              <span class="ticker-num">20</span> Years Of Experience &nbsp;<span class="ticker-spark">✦</span>&nbsp; <span class="ticker-num">170+</span> Projects Delivered &nbsp;<span class="ticker-spark">✦</span>&nbsp;&nbsp;
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Header — burger left, logo centered -->
  <div class="relative flex md:hidden items-center justify-between px-5 py-4">
    <!-- Burger left -->
    <button id="mobile-toggle" class="p-2 z-10" aria-label="Toggle menu">
      <div class="space-y-1.5">
        <span class="block w-6 h-px bg-secondary transition-all duration-300"></span>
        <span class="block w-7 h-px bg-secondary transition-all duration-300"></span>
        <span class="block w-6 h-px bg-secondary transition-all duration-300"></span>
      </div>
    </button>

    <!-- Logo centered -->
    <a href="/" class="absolute left-1/2 -translate-x-1/2" aria-label="Inscape Interiors home">
      <img
        src="/images/inscape_logo.png"
        alt="Inscape Interiors"
        class="h-16 w-auto block"
      />
    </a>

    <!-- Spacer to balance burger -->
    <div class="w-10 z-10"></div>
  </div>

  <!-- Mobile Ticker Bar with warm gold accent and glow -->
  <div class="md:hidden w-full border-t border-b border-amber-900/15 py-1.5 px-2 bg-gradient-to-r from-primary via-[#f7ecd2] to-primary overflow-hidden shadow-inner">
    <div class="header-ticker-box header-ticker-glow-mobile w-full max-w-[340px] mx-auto overflow-hidden rounded-full py-1 px-3">
      <div class="header-ticker-track flex">
        <div class="header-ticker-item flex items-center shrink-0">
          <span class="font-serif text-[13px] tracking-wider uppercase font-bold text-secondary whitespace-nowrap">
            <span class="ticker-num">20</span> Years Of Experience &nbsp;<span class="ticker-spark">✦</span>&nbsp; <span class="ticker-num">170+</span> Projects Delivered &nbsp;<span class="ticker-spark">✦</span>&nbsp;&nbsp;
          </span>
        </div>
        <div class="header-ticker-item flex items-center shrink-0" aria-hidden="true">
          <span class="font-serif text-[13px] tracking-wider uppercase font-bold text-secondary whitespace-nowrap">
            <span class="ticker-num">20</span> Years Of Experience &nbsp;<span class="ticker-spark">✦</span>&nbsp; <span class="ticker-num">170+</span> Projects Delivered &nbsp;<span class="ticker-spark">✦</span>&nbsp;&nbsp;
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-primary border-t border-secondary/10"
  >
    <nav class="px-5 py-8 flex flex-col gap-4">
      <a href="/projects" class="text-[16px] font-serif font-bold">Projects</a>
      <a href="/craftsmanship" class="text-[16px] font-serif font-bold">Craftsmanship</a>
      <a href="/services" class="text-[16px] font-serif font-bold">Services</a>
      <a href="/about" class="text-[16px] font-serif font-bold">About</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>

<script>
  const header = document.querySelector<HTMLElement>(".header-hide");
  let lastScroll = 0;
  if (header) {
    window.addEventListener(
      "scroll",
      () => {
        const currentScroll = window.scrollY;
        if (currentScroll > lastScroll && currentScroll > 80) {
          header.style.transform = "translateY(-100%)";
        } else {
          header.style.transform = "translateY(0)";
        }
        lastScroll = currentScroll;
      },
      { passive: true },
    );
  }
</script>

<style>
  .header-hide {
    position: sticky;
    top: 0;
    transition: transform 0.3s ease;
  }

  /* Header Ticker Styles */
  .header-ticker-box {
    position: relative;
    mask-image: linear-gradient(90deg, transparent 0%, black 10%, black 90%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 10%, black 90%, transparent 100%);
  }

  /* Desktop Ticker Glow Container */
  .header-ticker-glow {
    background: linear-gradient(135deg, rgba(255, 252, 244, 0.95) 0%, rgba(247, 237, 210, 0.9) 100%);
    border: 1.5px solid rgba(197, 155, 69, 0.65);
    box-shadow:
      0 0 14px rgba(212, 168, 83, 0.45),
      0 0 28px rgba(212, 168, 83, 0.22),
      inset 0 0 8px rgba(255, 248, 225, 0.6);
    animation: ticker-ambient-pulse 3.5s ease-in-out infinite alternate;
  }

  .header-ticker-glow:hover {
    border-color: rgba(181, 138, 59, 0.95);
    box-shadow:
      0 0 22px rgba(212, 168, 83, 0.7),
      0 0 40px rgba(212, 168, 83, 0.35),
      inset 0 0 12px rgba(255, 248, 225, 0.9);
    transform: scale(1.02);
  }

  /* Mobile Ticker Glow */
  .header-ticker-glow-mobile {
    background: rgba(255, 252, 243, 0.95);
    border: 1px solid rgba(197, 155, 69, 0.55);
    box-shadow: 0 0 10px rgba(212, 168, 83, 0.35);
  }

  /* Golden Spark Symbols with radiant glint */
  .ticker-spark {
    color: #b58228;
    text-shadow:
      0 0 6px rgba(212, 168, 83, 0.8),
      0 0 12px rgba(181, 138, 59, 0.5);
    display: inline-block;
    filter: drop-shadow(0 0 3px rgba(205, 150, 40, 0.6));
    animation: spark-twinkle 2.5s ease-in-out infinite alternate;
  }

  /* Ticker numbers: scale up to match capital letter cap-height and use lining figures */
  .ticker-num {
    font-variant-numeric: lining-nums tabular-nums;
    -moz-font-feature-settings: "lnum" 1;
    -webkit-font-feature-settings: "lnum" 1;
    font-feature-settings: "lnum" 1;
    font-size: 1.28em;
    font-weight: 700;
    display: inline-block;
    vertical-align: -0.04em;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .header-ticker-track {
    width: max-content;
    animation: header-ticker-slide 14s linear infinite;
    will-change: transform;
  }

  .header-ticker-box:hover .header-ticker-track {
    animation-play-state: paused;
  }

  @keyframes ticker-ambient-pulse {
    0% {
      border-color: rgba(197, 155, 69, 0.5);
      box-shadow:
        0 0 12px rgba(212, 168, 83, 0.4),
        0 0 24px rgba(212, 168, 83, 0.18),
        inset 0 0 6px rgba(255, 248, 225, 0.5);
    }
    100% {
      border-color: rgba(218, 165, 32, 0.88);
      box-shadow:
        0 0 18px rgba(218, 165, 32, 0.65),
        0 0 34px rgba(218, 165, 32, 0.28),
        inset 0 0 10px rgba(255, 248, 225, 0.75);
    }
  }

  @keyframes spark-twinkle {
    0% {
      opacity: 0.85;
      transform: scale(0.95);
    }
    100% {
      opacity: 1;
      transform: scale(1.15);
      filter: drop-shadow(0 0 6px rgba(218, 165, 32, 0.9));
    }
  }

  @keyframes header-ticker-slide {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-ticker-track,
    .header-ticker-glow,
    .ticker-spark {
      animation: none;
    }
  }
</style>
