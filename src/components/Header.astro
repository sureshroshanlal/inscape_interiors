---
---

<header class="header-hide sticky top-0 z-50 w-full bg-[#f8f6f0] transition-transform duration-300 ease-out">
  <!-- Desktop -->
  <div class="relative hidden h-[120px] items-center justify-center px-8 md:flex">
    
    <!-- Left Navigation -->
    <nav class="absolute left-8 top-1/2 -translate-y-1/2">
      <ul class="flex flex-col gap-1.5 font-serif text-[17px] font-semibold tracking-wide text-[#1a1208]">
        <li><a href="/projects" class="hover:text-[#a67c1a] transition-colors duration-200">Projects</a></li>
        <li><a href="/services" class="hover:text-[#a67c1a] transition-colors duration-200">Services</a></li>
        <li><a href="/craftsmanship" class="hover:text-[#a67c1a] transition-colors duration-200">Craftsmanship</a></li>
        <li><a href="/sourcing" class="hover:text-[#a67c1a] transition-colors duration-200">Sourcing</a></li>
        <li><a href="/about" class="hover:text-[#a67c1a] transition-colors duration-200">About</a></li>
      </ul>
    </nav>

    <!-- Center Logo (dead center) -->
    <a href="/" class="relative z-10 flex flex-col items-center">
      <img
        src="/images/inscape_logo.webp"
        alt="Inscape Interiors"
        class="h-[72px] w-auto"
        width="220"
        height="72"
      />
      <!-- infinity mark overlay if needed -->
      <img
        src="/logo-infinity.svg"
        alt=""
        class="pointer-events-none absolute"
        style="width: 18px; top: 4px; left: 28px;"
        width="18"
        height="12"
      />
    </a>

    <!-- Right Experience Badge (hard right) -->
    <div
      class="gold-badge absolute right-8 top-1/2 -translate-y-1/2"
      role="note"
      aria-label="20 plus years of experience with 170 plus projects delivered"
    >
      <span class="spark spark-1" aria-hidden="true"></span>
      <span class="spark spark-2" aria-hidden="true"></span>
      <span class="spark spark-3" aria-hidden="true"></span>
      <span class="spark spark-4" aria-hidden="true"></span>
      
      <div class="gold-badge-inner">
        <div class="stat">
          <span class="num">20+</span>
          <span class="lbl">Years of Experience</span>
        </div>
        <span class="divider" aria-hidden="true"></span>
        <div class="stat">
          <span class="num">170+</span>
          <span class="lbl">Projects Delivered</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile -->
  <div class="relative flex items-center justify-between px-5 py-4 md:hidden">
    <button
      id="mobile-toggle"
      class="z-10 p-2"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <div class="space-y-1.5">
        <span class="block h-px w-6 bg-[#1a1208] transition-all duration-300"></span>
        <span class="block h-px w-7 bg-[#1a1208] transition-all duration-300"></span>
        <span class="block h-px w-6 bg-[#1a1208] transition-all duration-300"></span>
      </div>
    </button>

    <a href="/" class="absolute left-1/2 -translate-x-1/2">
      <img
        src="/images/inscape_logo.webp"
        alt="Inscape Interiors"
        class="h-12 w-auto"
        width="140"
        height="48"
      />
    </a>

    <div class="w-10" aria-hidden="true"></div>
  </div>

  <!-- Mobile experience strip -->
  <div class="flex justify-center px-5 pb-3 md:hidden">
    <div class="gold-badge gold-badge-mobile" role="note">
      <span class="spark spark-1" aria-hidden="true"></span>
      <span class="spark spark-3" aria-hidden="true"></span>
      <div class="gold-badge-inner">
        <span class="num">20+</span>
        <span class="lbl">Yrs Experience</span>
        <span class="divider" aria-hidden="true"></span>
        <span class="num">170+</span>
        <span class="lbl">Projects Delivered</span>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-[#1a1208]/10 bg-[#f8f6f0] md:hidden"
  >
    <nav class="flex flex-col gap-4 px-5 py-8">
      <a href="/projects" class="font-serif text-[16px] font-semibold text-[#1a1208]">Projects</a>
      <a href="/services" class="font-serif text-[16px] font-semibold text-[#1a1208]">Services</a>
      <a href="/craftsmanship" class="font-serif text-[16px] font-semibold text-[#1a1208]">Craftsmanship</a>
      <a href="/sourcing" class="font-serif text-[16px] font-semibold text-[#1a1208]">Sourcing</a>
      <a href="/about" class="font-serif text-[16px] font-semibold text-[#1a1208]">About</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });
</script>

<script>
  const header = document.querySelector<HTMLElement>(".header-hide");
  let lastScroll = 0;

  if (header) {
    window.addEventListener(
      "scroll",
      () => {
        const current = window.scrollY;
        if (current > lastScroll && current > 80) {
          header.style.transform = "translateY(-100%)";
        } else {
          header.style.transform = "translateY(0)";
        }
        lastScroll = current;
      },
      { passive: true }
    );
  }
</script>

<style>
  :root {
    --gold-1: #a67c1a;
    --gold-2: #e8c766;
    --gold-3: #f1d27a;
    --gold-dark: #7a5a0e;
    --gold-brown: #301804;
    --gold-divider: #b8923a;
    --badge-bg: #faf8f2;
  }

  /* Gold badge */
  .gold-badge {
    position: relative;
    padding: 1.5px;
    border-radius: 3px;
    background: linear-gradient(
      110deg,
      var(--gold-1) 0%,
      var(--gold-2) 25%,
      var(--gold-1) 50%,
      var(--gold-2) 75%,
      var(--gold-1) 100%
    );
    background-size: 250% 100%;
    animation:
      gold-flow 5s linear infinite,
      gold-glow 2.8s ease-in-out infinite;
  }

  .gold-badge-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 18px;
    border-radius: 2px;
    background: var(--badge-bg);
    overflow: hidden;
  }

  .gold-badge-inner::after {
    content: "";
    position: absolute;
    top: 0;
    left: -60%;
    width: 40%;
    height: 100%;
    background: linear-gradient(
      100deg,
      transparent,
      rgba(232, 199, 102, 0.4),
      transparent
    );
    transform: skewX(-20deg);
    animation: gold-sweep 4.5s ease-in-out infinite;
  }

  .gold-badge .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.05;
  }

  .gold-badge .num {
    font-weight: 700;
    font-size: 26px;
    color: var(--gold-dark);
    letter-spacing: 0.01em;
  }

  .gold-badge .lbl {
    margin-top: 2px;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-brown);
    text-align: center;
  }

  .gold-badge .divider {
    width: 1px;
    align-self: stretch;
    background: var(--gold-divider);
    opacity: 0.65;
  }

  /* Sparks */
  .gold-badge .spark {
    position: absolute;
    z-index: 2;
    width: 12px;
    height: 12px;
    background: var(--gold-3);
    clip-path: polygon(
      50% 0%, 60% 40%, 100% 50%, 60% 60%,
      50% 100%, 40% 60%, 0% 50%, 40% 40%
    );
    opacity: 0;
    animation: twinkle 3s ease-in-out infinite;
  }

  .spark-1 { top: -7px; left: 12%; animation-delay: 0s; }
  .spark-2 { top: -5px; right: 10%; width: 10px; height: 10px; animation-delay: 0.9s; }
  .spark-3 { bottom: -7px; right: 20%; animation-delay: 1.7s; }
  .spark-4 { bottom: -5px; left: 8%; width: 10px; height: 10px; animation-delay: 2.3s; }

  /* Mobile badge */
  .gold-badge-mobile .gold-badge-inner {
    gap: 6px;
    padding: 6px 12px;
  }
  .gold-badge-mobile .num { font-size: 16px; }
  .gold-badge-mobile .lbl {
    margin-top: 0;
    font-size: 9px;
    letter-spacing: 0.08em;
  }
  .gold-badge-mobile .divider { margin: 0 3px; }

  @keyframes gold-flow {
    to { background-position: -250% 0; }
  }
  @keyframes gold-glow {
    0%, 100% { box-shadow: 0 0 4px rgba(200, 160, 50, 0.3); }
    50%      { box-shadow: 0 0 14px rgba(220, 180, 70, 0.65); }
  }
  @keyframes gold-sweep {
    0%, 55% { left: -60%; }
    100%    { left: 130%; }
  }
  @keyframes twinkle {
    0%, 100% { opacity: 0; transform: scale(0.3) rotate(0deg); }
    50%      { opacity: 1; transform: scale(1) rotate(45deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gold-badge,
    .gold-badge-inner::after,
    .gold-badge .spark {
      animation: none;
    }
    .gold-badge .spark { opacity: 0.75; }
  }
</style>
